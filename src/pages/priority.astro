---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import GoldSeparator from '../components/GoldSeparator.astro';
import ChecklistItem from '../components/ChecklistItem.astro';
---

<Layout
  title="Build It Remarkable — Join the Priority List"
  description="A heart-led program for creative educators. Courses, memberships, workshops & coaching. Limited enrollment. Join the waitlist now."
>
  <Nav currentPage="/priority" />

  <!-- ═══════════════════════════════════════════════════
       HERO — Premium warm gradient — sales page energy
       BIR logo + cohort portrait + headline
       ═══════════════════════════════════════════════════ -->
  <section class="relative flex items-end overflow-hidden -mt-20 bg-brand-warm pt-24 pb-12">
    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12 w-full">
      <div class="flex flex-col lg:flex-row items-end gap-8 lg:gap-8">

        <!-- LEFT: BIR logo + cohort portrait stacked -->
        <div class="hero-visual self-end flex-shrink-0 flex flex-col items-center gap-0 lg:w-[44%]">
          <img
            src="/images/build-it-remarkable-logo.png"
            alt="Build It Remarkable"
            class="w-52 sm:w-64 lg:w-72 drop-shadow-xl mb-[-1.5rem] relative z-10"
            loading="eager"
          />
          <img
            src="/images/bir-cohort-opens-soon.png"
            alt="Kellee Wynne — Next Cohort Opens Soon"
            class="w-64 sm:w-80 lg:w-full max-w-sm drop-shadow-2xl"
            loading="eager"
            style="margin-bottom: -1px;"
          />
        </div>

        <!-- RIGHT: Headline + tagline + CTA -->
        <div class="text-center lg:text-left lg:w-[56%]">
          <p class="hero-eyebrow inline-block text-xs sm:text-sm font-semibold tracking-[0.22em] uppercase text-brand-gold mb-5 px-4 py-1.5 border border-brand-gold/40 rounded-full bg-brand-gold/10">
            A Heart-Led Program for Creative Educators
          </p>

          <h1 class="hero-headline font-display text-4xl sm:text-5xl lg:text-6xl uppercase text-brand-pink leading-tight mb-6">
            Don't Let Another Day Pass Without Your Dreams
          </h1>

          <p class="hero-sub font-accent text-xl sm:text-2xl text-brand-dark/70 leading-relaxed mb-4 max-w-lg lg:max-w-none">
            Designed just for Artists, Makers and Creatives!
          </p>

          <p class="hero-desc text-brand-dark/80 text-base sm:text-lg leading-relaxed mb-6 max-w-lg lg:max-w-none">
            Structured for creative educators who have courses, memberships, workshops or coaching programs — with limited enrollment to make sure <em class="text-brand-dark/80 not-italic font-semibold">you actually master the skills</em> needed to build a profitable, sustainable business that fits your vision.
          </p>

          <div class="hero-urgency inline-flex items-center gap-3 bg-brand-pink/15 border border-brand-pink/40 rounded-xl px-6 py-3 mb-6">
            <span class="w-2.5 h-2.5 rounded-full bg-brand-pink animate-pulse flex-shrink-0"></span>
            <span class="font-display text-sm sm:text-base tracking-widest text-brand-pink uppercase">We'll Be Back Early Spring 2026!</span>
          </div>

          <div class="hero-cta">
            <a
              href="#waitlist-form"
              class="bg-brand-gold text-brand-dark font-display uppercase tracking-widest px-10 py-4 rounded-lg shadow-lg hover:brightness-110 hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300"
            >
              Please Add Me to the List!
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════
       QUOTE — Howard Thurman
       ═══════════════════════════════════════════════════ -->
  <section class="py-12 sm:py-16 bg-brand-warm">
    <div class="max-w-3xl mx-auto px-6 lg:px-10 text-center">
      <div class="text-brand-gold/30 font-display text-[9rem] leading-none select-none -mb-10 block" aria-hidden="true">&ldquo;</div>
      <blockquote class="font-accent text-2xl sm:text-3xl lg:text-4xl text-brand-dark leading-snug mb-8">
        Don't ask what the world needs. Ask what makes you come alive, and go do it. Because what the world needs is people who have come alive.
      </blockquote>
      <GoldSeparator />
      <cite class="not-italic font-semibold text-sm tracking-widest uppercase text-brand-dark/50">
        Howard Thurman
      </cite>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════
       TESTIMONIALS — Personal, trustworthy, card grid
       ═══════════════════════════════════════════════════ -->
  <section class="py-12 sm:py-16 bg-white">
    <div class="max-w-6xl mx-auto px-6 lg:px-10">

      <SectionHeading
        overline="Real Results. Real Builders."
        title='Hear What the Builders Have to<br class="hidden sm:block" /> Say About Working with Kellee'
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <TestimonialCard
          quote='I have had the privilege of working with Kellee for the past three years, and I can confidently say that partnering with her has been one of the best decisions for my business. Kellee&rsquo;s expertise and guidance have been instrumental in scaling my online art class business from a modest five-figure income to <strong class="text-brand-dark">a thriving operation generating multiple six figures annually.</strong>'
          name="Drew Steinbrecher"
          title="Build It Remarkable Alumni"
          initial="D"
        />

        <TestimonialCard
          quote='Build It Remarkable gave me the foundations and building blocks to begin to construct a solid framework for my creative business. Since taking the course, I have developed two juicy lead magnets and <strong class="text-brand-dark">my email list has grown by an amazing 270%.</strong> I now have clarity in my direction and the tools to take me where I want to go.'
          name="Sue Bulmer"
          title="Build It Remarkable Alumni"
          initial="S"
        />

        <TestimonialCard
          quote='Working with Kellee to build my online art course business was hands down <strong class="text-brand-dark">the single best and most cost effective decision I&rsquo;ve made.</strong> I&rsquo;ve learned exactly how to build an entire infrastructure to attract my ideal customer and launch my courses. I&rsquo;ve gotten so much from what Kellee teaches that I&rsquo;ve signed up 3 years in a row and continue to exponentially grow every year. My only regret is that I didn&rsquo;t work with her years earlier.'
          name="Cat Rains"
          title="3-Year Build It Remarkable Alumni"
          initial="C"
        />

        <TestimonialCard
          quote='Kellee shares this sales page format, which is just absolute gold. Like that alone is just worth it. I did the launch like you told us &mdash; with the live webinars, kept promoting last minute mail shots, kept focusing on my newsletter. And it worked. <strong class="text-brand-dark">I have never made that much money off a single product.</strong>'
          name="Tania Ahmed"
          title="Build It Remarkable Alumni"
          initial="T"
        />
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════
       ABOUT KELLEE — Meet your guide section
       ═══════════════════════════════════════════════════ -->
  <section class="py-12 sm:py-16 bg-white">
    <div class="max-w-5xl mx-auto px-6 lg:px-10">
      <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12">

        <div class="flex-shrink-0 about-portrait">
          <img
            src="/images/kellee-splat-portrait.png"
            alt="Kellee Wynne"
            class="w-52 sm:w-64 md:w-72 drop-shadow-xl"
            loading="lazy"
          />
        </div>

        <div class="text-center md:text-left">
          <SectionHeading
            overline="Your Guide"
            title="Hi! I'm Kellee Wynne"
            centered={false}
          />
          <p class="font-accent text-lg sm:text-xl text-brand-dark/70 leading-relaxed mb-4">
            Artist, Writer and Strategy Expert for Art Course Creators
          </p>
          <p class="text-brand-dark/70 text-base leading-relaxed mb-4">
            After more than a decade of online business experience and mentoring some of the best known creative educators, I've carved out a simpler, more sustainable path to success rooted in purpose, creativity, and actually <em class="text-brand-dark not-italic font-semibold">enjoying the life you're building.</em>
          </p>
          <p class="text-brand-dark/70 text-base leading-relaxed mb-4">
            I host the <span class="text-brand-gold font-semibold">Made Remarkable™ Podcast</span>, where we talk about what it really means to show up for your work and your calling. I write <span class="text-brand-gold font-semibold">Build it with Kellee Wynne</span>, a weekly newsletter for creatives ready to do business with more soul and strategy. My own art courses have reached over <span class="text-brand-dark font-semibold">20,000 students around the world.</span>
          </p>
          <p class="text-brand-dark/70 text-base leading-relaxed mb-4">
            My book <em class="text-brand-dark/85 not-italic font-medium">Mixed Media Color Workshop</em> published by Quarto Books dives into modern color theory.
          </p>
          <p class="text-brand-dark/70 text-base leading-relaxed">
            I'd love to connect with you on <a href="https://www.instagram.com/kelleewynne/" target="_blank" rel="noopener noreferrer" class="text-brand-pink hover:text-brand-gold transition-colors duration-200 font-semibold">Instagram</a>.
          </p>
        </div>

      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════
       IS THIS RIGHT FOR YOU? — Qualifying checklist
       ═══════════════════════════════════════════════════ -->
  <section class="py-12 sm:py-16 bg-brand-warm">
    <div class="max-w-3xl mx-auto px-6 lg:px-10">

      <SectionHeading
        overline="Find Out If It's Your Time"
        title='Is Build It Remarkable<br class="hidden sm:block" /> the Right Path for You?'
      />

      <ul class="space-y-3">
        <ChecklistItem text='You have <strong class="text-brand-dark">Big Audacious Dreams</strong> of growing your course or membership business into a profitable, sustainable income that truly supports your creative life.' />
        <ChecklistItem text='You know you can make a bigger impact, but you struggle knowing how to <strong class="text-brand-dark">structure your business to make it grow</strong> &mdash; and you&rsquo;re wondering if you&rsquo;re even on the right path.' />
        <ChecklistItem text='You feel like you&rsquo;ve been <strong class="text-brand-dark">spinning your wheels</strong> for far too long and you just want real answers for current marketing strategies that are relevant to a creative business &mdash; not bro marketers or boss babes.' />
        <ChecklistItem text='You&rsquo;ve tried so many tactics to get your business to take off, but <strong class="text-brand-dark">your social media isn&rsquo;t attracting the right people, your list isn&rsquo;t growing</strong> and you don&rsquo;t know how to make consistent sales online.' />
        <ChecklistItem text='You&rsquo;re ready to <strong class="text-brand-dark">think outside the box</strong> with new strategies for creative business development beyond selling physical products. We focus on digital courses, workshops, collaborations and memberships.' />
        <ChecklistItem text='You are <strong class="text-brand-dark">committed to growing your creative business</strong> and ready to invest &mdash; physically, emotionally and financially.' />
        <ChecklistItem text='Someone who thrives in a <strong class="text-brand-dark">Diverse, Equitable and Inclusive</strong> environment and is committed to showing up to elevate yourself and others in their success.' />
        <ChecklistItem text='Looking for <strong class="text-brand-dark">support, community, accountability</strong> and wanting to surround yourself with other creative business owners who get you, and will help you breakthrough to achieve your dreams.' />
      </ul>

      <!-- Mid-page CTA -->
      <div class="mt-10 text-center">
        <p class="font-accent text-xl sm:text-2xl text-brand-dark/70 mb-6 leading-relaxed">
          If you're nodding along — you belong in Build It Remarkable.
        </p>
        <a
          href="#waitlist-form"
          class="bg-brand-gold text-brand-dark font-display uppercase tracking-widest px-10 py-4 rounded-lg shadow-lg hover:brightness-110 hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300"
        >
          Save My Spot on the List
        </a>
      </div>

    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════
       WAITLIST FORM — Bottom anchor, high-contrast, urgent
       ═══════════════════════════════════════════════════ -->
  <section id="waitlist-form" class="py-12 sm:py-16 bg-brand-dark text-white">
    <div class="max-w-xl mx-auto px-6 lg:px-10 text-center">

      <img
        src="/images/build-it-remarkable-logo.png"
        alt="Build It Remarkable"
        class="w-40 sm:w-48 mx-auto mb-6 drop-shadow-lg"
        loading="lazy"
      />

      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl uppercase text-white leading-tight mb-3">
        Build It Remarkable<br />Priority List
      </h2>

      <div class="inline-flex items-center gap-2 bg-brand-gold/15 border border-brand-gold/40 rounded-full px-5 py-2 mb-6">
        <span class="w-2 h-2 rounded-full bg-brand-gold animate-pulse flex-shrink-0"></span>
        <span class="text-brand-gold font-semibold text-xs sm:text-sm tracking-widest uppercase">
          The Next Cohort Opens Early Spring 2026!
        </span>
      </div>

      <p class="text-white/55 text-base leading-relaxed mb-8">
        Be the first to know when enrollment opens — and get exclusive early-access details before anyone else.
      </p>

      <div class="bg-white/[0.06] backdrop-blur-sm border border-white/10 rounded-2xl p-8 shadow-2xl">
        <form class="space-y-4" onsubmit="return false;" aria-label="Build It Remarkable Priority Waitlist">
          <div class="text-left">
            <label for="bir-first-name" class="block text-xs font-semibold tracking-[0.15em] uppercase text-white/50 mb-2">
              First Name
            </label>
            <input
              type="text"
              id="bir-first-name"
              name="first_name"
              placeholder="Your first name"
              autocomplete="given-name"
              class="w-full bg-white/10 border border-white/15 rounded-lg px-5 py-3.5 text-white placeholder-white/30 text-base focus:outline-none focus:border-brand-gold focus:bg-white/15 transition-all duration-200"
            />
          </div>
          <div class="text-left">
            <label for="bir-email" class="block text-xs font-semibold tracking-[0.15em] uppercase text-white/50 mb-2">
              Email Address
            </label>
            <input
              type="email"
              id="bir-email"
              name="email"
              placeholder="your@email.com"
              autocomplete="email"
              class="w-full bg-white/10 border border-white/15 rounded-lg px-5 py-3.5 text-white placeholder-white/30 text-base focus:outline-none focus:border-brand-gold focus:bg-white/15 transition-all duration-200"
            />
          </div>
          <div class="pt-2">
            <button
              type="submit"
              class="w-full bg-brand-gold text-brand-dark font-display uppercase tracking-widest px-10 py-4 rounded-lg shadow-lg hover:brightness-110 hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300"
            >
              Yes, Put Me on the List!
            </button>
          </div>
          <p class="text-white/50 text-xs pt-1">
            No spam, ever. Unsubscribe anytime. Your email is safe with us.
          </p>
        </form>
      </div>

    </div>
  </section>


  <Footer />
</Layout>

<style>
  /* Hero entrance animations */
  .hero-visual    { animation: fadeInLeft 0.9s ease-out 0.05s both; }
  .hero-eyebrow   { animation: fadeInUp  0.7s ease-out 0.15s both; }
  .hero-headline  { animation: fadeInUp  0.8s ease-out 0.25s both; }
  .hero-sub       { animation: fadeInUp  0.8s ease-out 0.38s both; }
  .hero-desc      { animation: fadeInUp  0.8s ease-out 0.48s both; }
  .hero-urgency   { animation: fadeInUp  0.8s ease-out 0.58s both; }
  .hero-cta       { animation: fadeInUp  0.8s ease-out 0.68s both; }

  /* Scroll-reveal for qualifying items */
  @keyframes revealItem {
    from { opacity: 0; transform: translateX(-1rem); }
    to   { opacity: 1; transform: translateX(0); }
  }

  .qualify-item {
    opacity: 0;
    animation: revealItem 0.5s ease-out forwards;
  }

  .qualify-item:nth-child(1) { animation-delay: 0.05s; }
  .qualify-item:nth-child(2) { animation-delay: 0.12s; }
  .qualify-item:nth-child(3) { animation-delay: 0.19s; }
  .qualify-item:nth-child(4) { animation-delay: 0.26s; }
  .qualify-item:nth-child(5) { animation-delay: 0.33s; }
  .qualify-item:nth-child(6) { animation-delay: 0.40s; }
  .qualify-item:nth-child(7) { animation-delay: 0.47s; }
  .qualify-item:nth-child(8) { animation-delay: 0.54s; }

  /* Testimonial card entrance */
  .testimonial-card {
    opacity: 0;
    animation: fadeIn 0.6s ease-out forwards;
  }

  .testimonial-card:nth-child(1) { animation-delay: 0.1s; }
  .testimonial-card:nth-child(2) { animation-delay: 0.2s; }
  .testimonial-card:nth-child(3) { animation-delay: 0.3s; }
  .testimonial-card:nth-child(4) { animation-delay: 0.4s; }

  /* About portrait entrance */
  .about-portrait {
    animation: fadeInLeft 0.9s ease-out 0.1s both;
  }

  /* Smooth scroll anchor offset for fixed nav */
  #waitlist-form {
    scroll-margin-top: 5rem;
  }
</style>

<script>
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -60px 0px',
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const items = entry.target.querySelectorAll('.qualify-item, .testimonial-card');
        items.forEach(item => {
          (item as HTMLElement).style.animationPlayState = 'running';
          (item as HTMLElement).style.opacity = '';
        });
      }
    });
  }, observerOptions);

  document.querySelectorAll('section').forEach(section => {
    observer.observe(section);
  });

  const deferItems = document.querySelectorAll('.qualify-item, .testimonial-card');
  deferItems.forEach(item => {
    const rect = item.getBoundingClientRect();
    if (rect.top > window.innerHeight) {
      (item as HTMLElement).style.animationPlayState = 'paused';
    }
  });
</script>
