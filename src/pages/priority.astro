---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Build It Remarkable — Join the Priority List"
  description="A heart-led program for creative educators. Courses, memberships, workshops & coaching. Limited enrollment. Join the waitlist now."
>
  <Nav currentPage="/priority" />

  <!-- ═══════════════════════════════════════════════════
       HERO — Premium dark gradient — sales page energy, no art texture
       BIR logo + cohort portrait + headline
       ═══════════════════════════════════════════════════ -->
  <section class="relative flex items-end overflow-hidden -mt-20 bg-brand-warm pt-24 pb-12">
    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12 w-full">
      <div class="flex flex-col lg:flex-row items-end gap-8 lg:gap-8">

        <!-- LEFT: BIR logo + cohort portrait stacked -->
        <div class="hero-visual self-end flex-shrink-0 flex flex-col items-center gap-0 lg:w-[44%]">
          <!-- BIR program logo -->
          <img
            src="/images/build-it-remarkable-logo.png"
            alt="Build It Remarkable"
            class="w-52 sm:w-64 lg:w-72 drop-shadow-xl mb-[-1.5rem] relative z-10"
            loading="eager"
          />
          <!-- Cohort opens soon portrait — grounded, textured -->
          <img
            src="/images/bir-cohort-opens-soon.png"
            alt="Kellee Wynne — Next Cohort Opens Soon"
            class="w-64 sm:w-80 lg:w-full max-w-sm drop-shadow-2xl"
            loading="eager"
            style="margin-bottom: -1px;"
          />
        </div>

        <!-- RIGHT: Headline + tagline + CTA -->
        <div class="text-center lg:text-left lg:w-[56%]">

          <!-- Eyebrow label -->
          <p class="hero-eyebrow inline-block text-xs sm:text-sm font-semibold tracking-[0.22em] uppercase text-brand-gold mb-5 px-4 py-1.5 border border-brand-gold/40 rounded-full bg-brand-gold/10">
            A Heart-Led Program for Creative Educators
          </p>

          <!-- Main headline -->
          <h1 class="hero-headline font-display text-4xl sm:text-5xl lg:text-6xl uppercase text-brand-pink leading-tight mb-6">
            Don't Let Another Day Pass Without Your Dreams
          </h1>

          <!-- Tagline -->
          <p class="hero-sub font-accent text-xl sm:text-2xl text-brand-dark/70 leading-relaxed mb-4 max-w-lg lg:max-w-none">
            Designed just for Artists, Makers and Creatives!
          </p>

          <!-- Description -->
          <p class="hero-desc text-brand-dark/60 text-base sm:text-lg leading-relaxed mb-6 max-w-lg lg:max-w-none">
            Structured for creative educators who have courses, memberships, workshops or coaching programs — with limited enrollment to make sure <em class="text-brand-dark/80 not-italic font-semibold">you actually master the skills</em> needed to build a profitable, sustainable business that fits your vision.
          </p>

          <!-- Urgency badge -->
          <div class="hero-urgency inline-flex items-center gap-3 bg-brand-pink/15 border border-brand-pink/40 rounded-xl px-6 py-3 mb-6">
            <span class="w-2.5 h-2.5 rounded-full bg-brand-pink animate-pulse flex-shrink-0"></span>
            <span class="font-display text-sm sm:text-base tracking-widest text-brand-pink uppercase">We'll Be Back Early Spring 2026!</span>
          </div>

          <!-- Primary CTA -->
          <div class="hero-cta">
            <a
              href="#waitlist-form"
              class="bg-brand-gold text-brand-dark font-display uppercase tracking-widest px-10 py-4 rounded-lg shadow-lg hover:brightness-110 hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300"
            >
              Please Add Me to the List!
            </a>
          </div>

        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════
       QUOTE — Howard Thurman. Big, atmospheric, serif.
       ═══════════════════════════════════════════════════ -->
  <section class="py-12 sm:py-16 bg-brand-warm">
    <div class="max-w-3xl mx-auto px-6 lg:px-10 text-center">
      <!-- Decorative opening mark -->
      <div class="text-brand-gold/30 font-display text-[9rem] leading-none select-none -mb-10 block" aria-hidden="true">&ldquo;</div>

      <blockquote class="font-accent text-2xl sm:text-3xl lg:text-4xl text-brand-dark leading-snug mb-8">
        Don't ask what the world needs. Ask what makes you come alive, and go do it. Because what the world needs is people who have come alive.
      </blockquote>

      <!-- Gold separator + attribution -->
      <div class="flex items-center justify-center gap-4 mb-3">
        <div class="h-px w-12 bg-brand-gold/50"></div>
        <div class="w-1.5 h-1.5 rounded-full bg-brand-gold"></div>
        <div class="h-px w-12 bg-brand-gold/50"></div>
      </div>
      <cite class="not-italic font-semibold text-sm tracking-widest uppercase text-brand-dark/50">
        Howard Thurman
      </cite>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════
       TESTIMONIALS — Personal, trustworthy, card grid
       ═══════════════════════════════════════════════════ -->
  <section class="py-12 sm:py-16 bg-white">
    <div class="max-w-6xl mx-auto px-6 lg:px-10">

      <!-- Section header -->
      <p class="text-xs sm:text-sm font-semibold tracking-[0.2em] uppercase text-brand-pink text-center mb-3">
        Real Results. Real Builders.
      </p>
      <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl uppercase text-brand-dark leading-tight mb-4 text-center">
        Hear What the Builders Have to<br class="hidden sm:block" /> Say About Working with Kellee
      </h2>
      <div class="w-20 h-1 bg-brand-gold mx-auto mb-10 rounded-full"></div>

      <!-- Testimonial grid: 2 columns + 1 feature card spanning width on mobile -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

        <!-- Testimonial 1 — Drew Steinbrecher -->
        <div class="testimonial-card group relative bg-brand-warm border border-brand-gold/20 rounded-2xl p-8 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
          <div class="text-brand-gold/40 font-display text-5xl leading-none select-none mb-4" aria-hidden="true">&ldquo;</div>
          <blockquote class="text-brand-dark/75 text-base leading-relaxed mb-6">
            I have had the privilege of working with Kellee for the past three years, and I can confidently say that partnering with her has been one of the best decisions for my business. Kellee's expertise and guidance have been instrumental in scaling my online art class business from a modest five-figure income to <strong class="text-brand-dark">a thriving operation generating multiple six figures annually.</strong>
          </blockquote>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-brand-pink/15 flex items-center justify-center flex-shrink-0">
              <span class="font-display text-brand-pink text-base">D</span>
            </div>
            <div>
              <p class="font-semibold text-sm text-brand-dark">Drew Steinbrecher</p>
              <p class="text-xs text-brand-dark/40 tracking-wide">Build It Remarkable Alumni</p>
            </div>
          </div>
          <!-- Accent corner -->
          <div class="absolute top-0 right-0 w-12 h-12 rounded-tr-2xl overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-bl from-brand-gold/20 to-transparent"></div>
          </div>
        </div>

        <!-- Testimonial 2 — Sue Bulmer -->
        <div class="testimonial-card group relative bg-brand-warm border border-brand-gold/20 rounded-2xl p-8 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
          <div class="text-brand-pink/40 font-display text-5xl leading-none select-none mb-4" aria-hidden="true">&ldquo;</div>
          <blockquote class="text-brand-dark/75 text-base leading-relaxed mb-6">
            Build It Remarkable gave me the foundations and building blocks to begin to construct a solid framework for my creative business. Since taking the course, I have developed two juicy lead magnets and <strong class="text-brand-dark">my email list has grown by an amazing 270%.</strong> I now have clarity in my direction and the tools to take me where I want to go.
          </blockquote>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-brand-gold/15 flex items-center justify-center flex-shrink-0">
              <span class="font-display text-brand-gold text-base">S</span>
            </div>
            <div>
              <p class="font-semibold text-sm text-brand-dark">Sue Bulmer</p>
              <p class="text-xs text-brand-dark/40 tracking-wide">Build It Remarkable Alumni</p>
            </div>
          </div>
          <div class="absolute top-0 right-0 w-12 h-12 rounded-tr-2xl overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-bl from-brand-pink/15 to-transparent"></div>
          </div>
        </div>

        <!-- Testimonial 3 — Cat Rains -->
        <div class="testimonial-card group relative bg-brand-warm border border-brand-gold/20 rounded-2xl p-8 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
          <div class="text-brand-orange/40 font-display text-5xl leading-none select-none mb-4" aria-hidden="true">&ldquo;</div>
          <blockquote class="text-brand-dark/75 text-base leading-relaxed mb-6">
            Working with Kellee to build my online art course business was hands down <strong class="text-brand-dark">the single best and most cost effective decision I've made.</strong> I've learned exactly how to build an entire infrastructure to attract my ideal customer and launch my courses. I've gotten so much from what Kellee teaches that I've signed up 3 years in a row and continue to exponentially grow every year. My only regret is that I didn't work with her years earlier.
          </blockquote>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-brand-orange/15 flex items-center justify-center flex-shrink-0">
              <span class="font-display text-brand-orange text-base">C</span>
            </div>
            <div>
              <p class="font-semibold text-sm text-brand-dark">Cat Rains</p>
              <p class="text-xs text-brand-dark/40 tracking-wide">3-Year Build It Remarkable Alumni</p>
            </div>
          </div>
          <div class="absolute top-0 right-0 w-12 h-12 rounded-tr-2xl overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-bl from-brand-orange/15 to-transparent"></div>
          </div>
        </div>

        <!-- Testimonial 4 — Tania Ahmed -->
        <div class="testimonial-card group relative bg-brand-warm border border-brand-gold/20 rounded-2xl p-8 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
          <div class="text-brand-gold/40 font-display text-5xl leading-none select-none mb-4" aria-hidden="true">&ldquo;</div>
          <blockquote class="text-brand-dark/75 text-base leading-relaxed mb-6">
            Kellee shares this sales page format, which is just absolute gold. Like that alone is just worth it. I did the launch like you told us — with the live webinars, kept promoting last minute mail shots, kept focusing on my newsletter. And it worked. <strong class="text-brand-dark">I have never made that much money off a single product.</strong>
          </blockquote>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-brand-pink/15 flex items-center justify-center flex-shrink-0">
              <span class="font-display text-brand-pink text-base">T</span>
            </div>
            <div>
              <p class="font-semibold text-sm text-brand-dark">Tania Ahmed</p>
              <p class="text-xs text-brand-dark/40 tracking-wide">Build It Remarkable Alumni</p>
            </div>
          </div>
          <div class="absolute top-0 right-0 w-12 h-12 rounded-tr-2xl overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-bl from-brand-gold/20 to-transparent"></div>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════
       ABOUT KELLEE — Meet your guide section
       Dark with warm radial accents
       ═══════════════════════════════════════════════════ -->
  <section class="py-12 sm:py-16 bg-white">
    <div class="max-w-5xl mx-auto px-6 lg:px-10">
      <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12">

        <!-- Splat portrait -->
        <div class="flex-shrink-0 about-portrait">
          <img
            src="/images/kellee-splat-portrait.png"
            alt="Kellee Wynne"
            class="w-52 sm:w-64 md:w-72 drop-shadow-xl"
            loading="lazy"
          />
        </div>

        <!-- Bio content -->
        <div class="text-center md:text-left">
          <p class="text-xs sm:text-sm font-semibold tracking-[0.2em] uppercase text-brand-pink mb-3">
            Your Guide
          </p>
          <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl uppercase text-brand-dark leading-tight mb-4">
            Hi! I'm Kellee Wynne
          </h2>
          <p class="font-accent text-lg sm:text-xl text-brand-dark/70 leading-relaxed mb-4">
            Artist, Writer and Strategy Expert for Art Course Creators
          </p>
          <p class="text-brand-dark/70 text-base leading-relaxed mb-4">
            After more than a decade of online business experience and mentoring some of the best known creative educators, I've carved out a simpler, more sustainable path to success rooted in purpose, creativity, and actually <em class="text-brand-dark not-italic font-semibold">enjoying the life you're building.</em>
          </p>
          <p class="text-brand-dark/70 text-base leading-relaxed mb-4">
            I host the <span class="text-brand-gold font-semibold">Made Remarkable™ Podcast</span>, where we talk about what it really means to show up for your work and your calling. I write <span class="text-brand-gold font-semibold">Build it with Kellee Wynne</span>, a weekly newsletter for creatives ready to do business with more soul and strategy. My own art courses have reached over <span class="text-brand-dark font-semibold">20,000 students around the world.</span>
          </p>
          <p class="text-brand-dark/70 text-base leading-relaxed mb-4">
            My book <em class="text-brand-dark/85 not-italic font-medium">Mixed Media Color Workshop</em> published by Quarto Books dives into modern color theory.
          </p>
          <p class="text-brand-dark/70 text-base leading-relaxed">
            I'd love to connect with you on <a href="https://www.instagram.com/kelleewynne/" target="_blank" rel="noopener noreferrer" class="text-brand-pink hover:text-brand-gold transition-colors duration-200 font-semibold">Instagram</a>.
          </p>
        </div>

      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════
       IS THIS RIGHT FOR YOU? — Qualifying checklist
       Warm background, generous spacing, checkmarks
       ═══════════════════════════════════════════════════ -->
  <section class="py-12 sm:py-16 bg-brand-warm">
    <div class="max-w-3xl mx-auto px-6 lg:px-10">

      <!-- Section header -->
      <p class="text-xs sm:text-sm font-semibold tracking-[0.2em] uppercase text-brand-pink text-center mb-3">
        Find Out If It's Your Time
      </p>
      <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl uppercase text-brand-dark leading-tight mb-4 text-center">
        Is Build It Remarkable<br class="hidden sm:block" /> the Right Path for You?
      </h2>
      <div class="w-20 h-1 bg-brand-pink mx-auto mb-10 rounded-full"></div>

      <!-- Qualifying checklist -->
      <ul class="space-y-3">

        <li class="qualify-item flex items-start gap-5 bg-white/80 rounded-xl p-5 shadow-sm border border-brand-gold/15 hover:border-brand-gold/35 hover:shadow-md transition-all duration-300">
          <div class="flex-shrink-0 w-7 h-7 rounded-full bg-brand-gold flex items-center justify-center mt-0.5">
            <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <p class="text-brand-dark/80 text-base leading-relaxed">
            You have <strong class="text-brand-dark">Big Audacious Dreams</strong> of growing your course or membership business into a profitable, sustainable income that truly supports your creative life.
          </p>
        </li>

        <li class="qualify-item flex items-start gap-5 bg-white/80 rounded-xl p-5 shadow-sm border border-brand-gold/15 hover:border-brand-gold/35 hover:shadow-md transition-all duration-300">
          <div class="flex-shrink-0 w-7 h-7 rounded-full bg-brand-gold flex items-center justify-center mt-0.5">
            <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <p class="text-brand-dark/80 text-base leading-relaxed">
            You know you can make a bigger impact, but you struggle knowing how to <strong class="text-brand-dark">structure your business to make it grow</strong> — and you're wondering if you're even on the right path.
          </p>
        </li>

        <li class="qualify-item flex items-start gap-5 bg-white/80 rounded-xl p-5 shadow-sm border border-brand-gold/15 hover:border-brand-gold/35 hover:shadow-md transition-all duration-300">
          <div class="flex-shrink-0 w-7 h-7 rounded-full bg-brand-gold flex items-center justify-center mt-0.5">
            <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <p class="text-brand-dark/80 text-base leading-relaxed">
            You feel like you've been <strong class="text-brand-dark">spinning your wheels</strong> for far too long and you just want real answers for current marketing strategies that are relevant to a creative business — not bro marketers or boss babes.
          </p>
        </li>

        <li class="qualify-item flex items-start gap-5 bg-white/80 rounded-xl p-5 shadow-sm border border-brand-gold/15 hover:border-brand-gold/35 hover:shadow-md transition-all duration-300">
          <div class="flex-shrink-0 w-7 h-7 rounded-full bg-brand-gold flex items-center justify-center mt-0.5">
            <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <p class="text-brand-dark/80 text-base leading-relaxed">
            You've tried so many tactics to get your business to take off, but <strong class="text-brand-dark">your social media isn't attracting the right people, your list isn't growing</strong> and you don't know how to make consistent sales online.
          </p>
        </li>

        <li class="qualify-item flex items-start gap-5 bg-white/80 rounded-xl p-5 shadow-sm border border-brand-gold/15 hover:border-brand-gold/35 hover:shadow-md transition-all duration-300">
          <div class="flex-shrink-0 w-7 h-7 rounded-full bg-brand-gold flex items-center justify-center mt-0.5">
            <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <p class="text-brand-dark/80 text-base leading-relaxed">
            You're ready to <strong class="text-brand-dark">think outside the box</strong> with new strategies for creative business development beyond selling physical products. We focus on digital courses, workshops, collaborations and memberships.
          </p>
        </li>

        <li class="qualify-item flex items-start gap-5 bg-white/80 rounded-xl p-5 shadow-sm border border-brand-gold/15 hover:border-brand-gold/35 hover:shadow-md transition-all duration-300">
          <div class="flex-shrink-0 w-7 h-7 rounded-full bg-brand-gold flex items-center justify-center mt-0.5">
            <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <p class="text-brand-dark/80 text-base leading-relaxed">
            You are <strong class="text-brand-dark">committed to growing your creative business</strong> and ready to invest — physically, emotionally and financially.
          </p>
        </li>

        <li class="qualify-item flex items-start gap-5 bg-white/80 rounded-xl p-5 shadow-sm border border-brand-gold/15 hover:border-brand-gold/35 hover:shadow-md transition-all duration-300">
          <div class="flex-shrink-0 w-7 h-7 rounded-full bg-brand-gold flex items-center justify-center mt-0.5">
            <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <p class="text-brand-dark/80 text-base leading-relaxed">
            Someone who thrives in a <strong class="text-brand-dark">Diverse, Equitable and Inclusive</strong> environment and is committed to showing up to elevate yourself and others in their success.
          </p>
        </li>

        <li class="qualify-item flex items-start gap-5 bg-white/80 rounded-xl p-5 shadow-sm border border-brand-gold/15 hover:border-brand-gold/35 hover:shadow-md transition-all duration-300">
          <div class="flex-shrink-0 w-7 h-7 rounded-full bg-brand-gold flex items-center justify-center mt-0.5">
            <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <p class="text-brand-dark/80 text-base leading-relaxed">
            Looking for <strong class="text-brand-dark">support, community, accountability</strong> and wanting to surround yourself with other creative business owners who get you, and will help you breakthrough to achieve your dreams.
          </p>
        </li>

      </ul>

      <!-- Mid-page CTA pull-through -->
      <div class="mt-10 text-center">
        <p class="font-accent text-xl sm:text-2xl text-brand-dark/70 mb-6 leading-relaxed">
          If you're nodding along — you belong in Build It Remarkable.
        </p>
        <a
          href="#waitlist-form"
          class="bg-brand-gold text-brand-dark font-display uppercase tracking-widest px-10 py-4 rounded-lg shadow-lg hover:brightness-110 hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300"
        >
          Save My Spot on the List
        </a>
      </div>

    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════
       WAITLIST FORM — Bottom anchor, high-contrast, urgent
       Premium dark gradient + BIR logo + form
       ═══════════════════════════════════════════════════ -->
  <section id="waitlist-form" class="py-12 sm:py-16 bg-brand-dark text-white">
    <div class="max-w-xl mx-auto px-6 lg:px-10 text-center">

      <!-- BIR Logo above form -->
      <img
        src="/images/build-it-remarkable-logo.png"
        alt="Build It Remarkable"
        class="w-40 sm:w-48 mx-auto mb-6 drop-shadow-lg"
        loading="lazy"
      />

      <!-- Form heading -->
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl uppercase text-white leading-tight mb-3">
        Build It Remarkable<br />Priority List
      </h2>

      <!-- Urgency copy -->
      <div class="inline-flex items-center gap-2 bg-brand-gold/15 border border-brand-gold/40 rounded-full px-5 py-2 mb-6">
        <span class="w-2 h-2 rounded-full bg-brand-gold animate-pulse flex-shrink-0"></span>
        <span class="text-brand-gold font-semibold text-xs sm:text-sm tracking-widest uppercase">
          The Next Cohort Opens Early Spring 2026!
        </span>
      </div>

      <p class="text-white/55 text-base leading-relaxed mb-8">
        Be the first to know when enrollment opens — and get exclusive early-access details before anyone else.
      </p>

      <!-- Form card -->
      <div class="bg-white/[0.06] backdrop-blur-sm border border-white/10 rounded-2xl p-8 shadow-2xl">
        <form class="space-y-4" onsubmit="return false;" aria-label="Build It Remarkable Priority Waitlist">

          <!-- First Name -->
          <div class="text-left">
            <label for="bir-first-name" class="block text-xs font-semibold tracking-[0.15em] uppercase text-white/50 mb-2">
              First Name
            </label>
            <input
              type="text"
              id="bir-first-name"
              name="first_name"
              placeholder="Your first name"
              autocomplete="given-name"
              class="w-full bg-white/10 border border-white/15 rounded-lg px-5 py-3.5 text-white placeholder-white/30 text-base focus:outline-none focus:border-brand-gold focus:bg-white/15 transition-all duration-200"
            />
          </div>

          <!-- Email -->
