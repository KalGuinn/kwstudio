---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

const links = [
  { label: '🚀 Build It Remarkable', href: '/priority', primary: true },
  { label: '📋 100 Ways Free Guide', href: '/100', primary: false },
  { label: '📖 Mixed Media Color Studio', href: '/book', primary: false },
  { label: '🎙️ Made Remarkable Podcast', href: '/podcast', primary: false },
];

const socialLinks = [
  { href: 'https://www.instagram.com/kelleewynne', icon: 'simple-icons:instagram', label: 'Instagram' },
  { href: 'https://www.youtube.com/c/kelleewynne', icon: 'simple-icons:youtube', label: 'YouTube' },
  { href: 'https://www.pinterest.com/kelleewynne/', icon: 'simple-icons:pinterest', label: 'Pinterest' },
];
---

<Layout title="Links">
  <div class="relative min-h-screen flex flex-col items-center justify-center px-4 py-12 overflow-hidden">
    <!-- Base gradient -->
    <div class="absolute inset-0 bg-gradient-to-b from-brand-pink via-[#d43060] to-brand-orange"></div>

    <!-- Art background texture overlay -->
    <div
      class="absolute inset-0 opacity-10 mix-blend-multiply"
      style="background-image: url('/images/art-background.jpg'); background-size: cover; background-position: center;"
    ></div>

    <!-- Content -->
    <div class="relative z-10 flex flex-col items-center w-full">
      <!-- Splat portrait -->
      <div class="mb-4 drop-shadow-xl">
        <img
          src="/images/kellee-splat-portrait.png"
          alt="Kellee Wynne"
          class="w-28 h-28 object-cover rounded-full border-2 border-white/30"
        />
      </div>

      <h1 class="font-display text-white text-2xl uppercase tracking-wider mb-1 drop-shadow">Kellee Wynne</h1>
      <p class="font-accent text-white/85 text-sm mb-8 italic">Artist · Author · Mentor</p>

      <!-- Links -->
      <div class="w-full max-w-sm space-y-3">
        {links.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class:list={[
              'block w-full text-center py-3.5 rounded-full font-semibold text-sm transition-all duration-200',
              link.primary
                ? 'bg-white text-brand-dark hover:scale-[1.03] hover:shadow-[0_0_20px_rgba(255,255,255,0.45)] shadow-lg'
                : 'bg-white/15 text-white border border-white/25 hover:bg-white/28 hover:scale-[1.02] hover:border-white/50 backdrop-blur-sm',
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Social icons -->
      <div class="flex items-center gap-7 mt-10">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={link.label}
            class="text-white/65 hover:text-white transition-all duration-200 hover:scale-110 hover:drop-shadow-[0_0_6px_rgba(255,255,255,0.6)]"
          >
            <Icon name={link.icon} class="w-5 h-5" />
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
