---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import CallToAction from '../components/CallToAction.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Footer from '../components/Footer.astro';
import BrushDivider from '../components/BrushDivider.astro';
---

<Layout title="Kellee Wynne Studios — Artist, Author, Mentor" description="Kellee Wynne helps artists and makers turn their creative talent into profitable course businesses. Explore programs, grab the free guide, or listen to the podcast.">
  <Nav currentPage="/" />

  <!-- ═══════════════════════════════════════════════════
       HERO — Immersive, painterly, artist's welcome
       Uses real art-background.jpg texture + standing portrait
       ═══════════════════════════════════════════════════ -->
  <section class="relative min-h-[65vh] flex items-end -mt-20 pt-20" data-dark-overlay>
    <!-- Layer 1: Painterly art background texture -->
    <div
      class="absolute inset-0 bg-cover bg-center"
      style="background-image: url('/images/art-background.jpg');"
    ></div>

    <!-- Layer 2: Soft white wash overlay (matches original's rgba 0.34) -->
    <div class="absolute inset-0 bg-white/[.34]"></div>

    <!-- Layer 3: Subtle warm gradient for depth at edges -->
    <div class="absolute inset-0" style="background:
      radial-gradient(ellipse at 80% 20%, transparent 40%, rgba(255,255,255,0.3) 100%),
      linear-gradient(to bottom, transparent 60%, rgba(250,245,240,0.5) 100%);">
    </div>

    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12 w-full flex items-end">
      <div class="flex flex-col lg:flex-row items-end w-full gap-6 lg:gap-8">

        <!-- Portrait — large, grounded at bottom, flush to hero edge -->
        <div class="order-2 lg:order-1 flex-shrink-0 lg:w-[42%] self-end relative">
          <img
            src="/images/kellee-portrait-standing.png"
            alt="Kellee Wynne"
            class="w-72 sm:w-80 lg:w-full lg:object-contain mx-auto lg:mx-0 drop-shadow-[0_16px_48px_rgba(0,0,0,0.2)]"
            loading="eager"
            style="object-position: bottom; display: block; margin-bottom: -1px;"
          />
        </div>

        <!-- Text — right side, vertically centered -->
        <div class="order-1 lg:order-2 lg:w-[58%] text-center lg:text-left pt-8 pb-6 lg:pb-8 lg:pt-0 self-center">
          <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl tracking-tight uppercase text-brand-pink leading-tight mb-6">
            I'm so happy that you're here!
          </h1>
          <p class="font-semibold text-lg sm:text-xl lg:text-2xl text-brand-dark leading-snug mb-4 max-w-xl lg:max-w-none">
            Hey, Artists and Makers, Welcome to the place where your wild, weird and brilliant ideas come to life!
          </p>
          <p class="text-brand-dark/80 text-base sm:text-lg leading-relaxed mb-8 max-w-lg lg:max-w-none">
            I want to help you turn your talent into a profitable course business.
          </p>

          <div class="flex flex-col sm:flex-row items-center lg:items-start gap-3">
            <a href="/priority" class="bg-brand-gold text-brand-dark font-display uppercase tracking-widest px-10 py-4 rounded-lg shadow-lg hover:brightness-110 hover:shadow-xl hover:-translate-y-0.5 hover:scale-[1.02] transition-all duration-300">
              Build It Remarkable
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       CONNECT — "3 Ways We Can Connect Right Now"
       Warm section with offerings cards — large image-dominant layout
       ═══════════════════════════════════════════════════ -->
  <section class="py-12 sm:py-16 bg-white">
    <div class="max-w-6xl mx-auto px-6 lg:px-10">
      <div data-reveal>
        <SectionHeading
          overline="Let's Connect"
          title="Here Are 3 Ways We Can Connect Right Now"
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8" data-reveal-stagger>

        <!-- Card 1: Build It Remarkable -->
        <a
          href="/priority"
          class="group relative flex flex-col rounded-2xl overflow-hidden shadow-md hover:shadow-lg hover:-translate-y-1 transition-all duration-300 bg-brand-warm"
        >
          <div class="flex items-center justify-center bg-brand-dark px-6 aspect-video">
            <img
              src="/images/build-it-remarkable-logo.png"
              alt="Build It Remarkable"
              class="h-24 sm:h-20 lg:h-28 w-auto object-contain drop-shadow-md group-hover:scale-[1.03] transition-transform duration-300 bg-white/90 rounded-lg px-4 py-2"
              loading="lazy"
            />
          </div>
          <div class="flex flex-col flex-1 p-6 text-center">
            <h3 class="font-display text-xl uppercase text-brand-dark group-hover:text-brand-gold transition-colors duration-200 mb-2">
              Build It Remarkable
            </h3>
            <p class="text-sm text-brand-dark/80 leading-relaxed mb-4 flex-1">Our signature coaching program to help you turn your creative talent into a thriving course business.</p>
            <span class="text-brand-gold text-sm font-semibold tracking-wide uppercase opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              Learn More &rarr;
            </span>
          </div>
        </a>

        <!-- Card 2: 100 Ways Free Guide -->
        <a
          href="/free-guide"
          class="group relative flex flex-col rounded-2xl overflow-hidden shadow-md hover:shadow-lg hover:-translate-y-1 transition-all duration-300 bg-brand-warm"
        >
          <div class="overflow-hidden aspect-video">
            <img
              src="/images/steal-my-ideas-graphics.png"
              alt="100 Ways to Steal My Ideas"
              class="w-full h-full object-cover object-top group-hover:scale-[1.03] transition-transform duration-300"
              loading="lazy"
            />
          </div>
          <div class="flex flex-col flex-1 p-6 text-center">
            <h3 class="font-display text-xl uppercase text-brand-dark group-hover:text-brand-gold transition-colors duration-200 mb-2">
              100 Ways Free Guide
            </h3>
            <p class="text-sm text-brand-dark/80 leading-relaxed mb-4 flex-1">Download the free guide packed with creative business ideas you can start using today.</p>
            <span class="text-brand-gold text-sm font-semibold tracking-wide uppercase opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              Get It Free &rarr;
            </span>
          </div>
        </a>

        <!-- Card 3: Podcast -->
        <a
          href="/podcast"
          class="group relative flex flex-col rounded-2xl overflow-hidden shadow-md hover:shadow-lg hover:-translate-y-1 transition-all duration-300 bg-brand-warm"
        >
          <div class="flex items-center justify-center bg-brand-dark px-6 aspect-video">
            <div class="text-center">
              <div class="w-20 h-20 mx-auto mb-3 rounded-full bg-brand-orange/20 border-2 border-brand-orange flex items-center justify-center">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-10 h-10 text-brand-orange">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" />
                </svg>
              </div>
              <p class="font-accent text-brand-orange/80 text-base tracking-wider">Made Remarkable</p>
            </div>
          </div>
          <div class="flex flex-col flex-1 p-6 text-center">
            <h3 class="font-display text-xl uppercase text-brand-dark group-hover:text-brand-gold transition-colors duration-200 mb-2">
              Podcast
            </h3>
            <p class="text-sm text-brand-dark/80 leading-relaxed mb-4 flex-1">Listen to the podcast for real conversations about creativity, business, and showing up boldly.</p>
            <span class="text-brand-gold text-sm font-semibold tracking-wide uppercase opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              Listen Now &rarr;
            </span>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       ABOUT — Meet Kellee, warm and personal
       Art background texture with portrait
       ═══════════════════════════════════════════════════ -->
  <section class="py-12 sm:py-16 bg-white">
    <div class="max-w-6xl mx-auto px-6 lg:px-10">
      <div class="flex flex-col md:flex-row items-center gap-6 md:gap-10">
        <!-- Splat portrait — the artistic circular one with paint splatters -->
        <div class="flex-shrink-0" data-reveal="left">
          <img
            src="/images/kellee-splat-portrait.png"
            alt="Kellee Wynne"
            class="w-56 sm:w-72 drop-shadow-xl"
            loading="lazy"
          />
        </div>
        <div data-reveal="right">
          <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl uppercase text-brand-dark leading-tight mb-4">
            Meet Kellee
          </h2>
          <p class="text-brand-dark/80 text-lg leading-relaxed mb-4">
            Artist, author of <em class="text-brand-pink font-semibold not-italic">Mixed Media Color Studio</em>,
            and business mentor for creative entrepreneurs.
          </p>
          <p class="text-brand-dark/80 text-base leading-relaxed mb-6">
            I've spent years helping artists and makers turn their wild, weird, and brilliant ideas
            into thriving creative businesses. Whether you're just starting out or ready to scale,
            I'm here to help you build something remarkable.
          </p>
          <a
            href="/contact"
            class="text-brand-pink font-semibold hover:text-brand-gold transition-colors duration-200 inline-flex items-center gap-1"
          >
            Get to know me
            <span>→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       NEWSLETTER — Email signup for weekly notes
       ═══════════════════════════════════════════════════ -->
  <section class="relative py-12 sm:py-16 bg-brand-warm overflow-hidden">
    <!-- Subtle paint splatter accents -->
    <div class="absolute -left-10 top-1/3 w-36 h-36 rounded-full bg-brand-pink/[0.06] blur-2xl pointer-events-none hidden sm:block" aria-hidden="true"></div>
    <div class="absolute -right-12 bottom-1/4 w-28 h-28 rounded-full bg-brand-gold/[0.08] blur-2xl pointer-events-none hidden sm:block" aria-hidden="true"></div>

    <div class="relative max-w-2xl mx-auto px-6 lg:px-10">
      <div data-reveal>
        <SectionHeading
          overline="Stay Connected"
          title="Join the Newsletter"
        />
      </div>

      <p class="text-brand-dark/80 text-base sm:text-lg leading-relaxed text-center mb-8" data-reveal>
        Sign up for Kellee's real talk about purpose, profit, and showing up like you mean it.
        Weekly(ish) notes to help artists grow their course creator business. Smart ideas,
        honest insights, and strategy grounded in real-life experience.
      </p>

      <form onsubmit="return false;" class="font-body space-y-4" data-reveal>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="newsletter-name" class="sr-only">First Name</label>
            <input
              type="text"
              id="newsletter-name"
              name="name"
              placeholder="First Name"
              required
              class="w-full px-5 py-4 rounded-xl border border-brand-gold/30 bg-white text-brand-dark placeholder:text-brand-dark/35 focus:outline-none focus:ring-2 focus:ring-brand-gold/50 focus:border-brand-gold transition"
            />
          </div>
          <div>
            <label for="newsletter-email" class="sr-only">Email Address</label>
            <input
              type="email"
              id="newsletter-email"
              name="email"
              placeholder="Email Address"
              required
              class="w-full px-5 py-4 rounded-xl border border-brand-gold/30 bg-white text-brand-dark placeholder:text-brand-dark/35 focus:outline-none focus:ring-2 focus:ring-brand-gold/50 focus:border-brand-gold transition"
            />
          </div>
        </div>
        <button
          type="submit"
          class="w-full bg-brand-gold text-brand-dark font-display uppercase tracking-widest px-10 py-4 rounded-lg shadow-lg hover:brightness-110 hover:shadow-xl hover:-translate-y-0.5 hover:scale-[1.02] transition-all duration-300"
        >
          Sign Me Up!
        </button>
      </form>

      <p class="font-accent italic text-sm text-brand-dark/80 text-center mt-6">
        Join 13,000+ smart creatives who are building their art course business with Kellee Wynne.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       CTA — Bold, warm, action-oriented
       ═══════════════════════════════════════════════════ -->
  <div data-reveal>
    <CallToAction
      headline="Turn Your Creativity Into a Business"
      subtitle="Join the community of artists building something remarkable."
      buttonText="Start Here →"
      buttonHref="/contact"
    />
  </div>

  <Footer />
</Layout>

<style>
  /* Fade-in animation for hero content — @keyframes fadeInUp is defined globally in Layout */
  section:first-of-type h1 {
    animation: fadeInUp 0.8s ease-out both;
  }
  section:first-of-type p {
    animation: fadeInUp 0.8s ease-out 0.15s both;
  }
  section:first-of-type a {
    animation: fadeInUp 0.8s ease-out 0.3s both;
  }
  section:first-of-type img {
    animation: fadeInUp 1s ease-out 0.1s both;
  }
</style>
