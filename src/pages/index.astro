---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Card from '../components/Card.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import { Icon } from 'astro-icon/components';
---

<Layout title="Home">
  <Nav currentPage="/" />

  <!-- ═══════════════════════════════════════════════════
       HERO — Immersive, painterly, artist's welcome
       Uses real art-background.jpg texture + standing portrait
       ═══════════════════════════════════════════════════ -->
  <section class="relative min-h-[90vh] flex items-center overflow-hidden -mt-20">
    <!-- Layer 1: Painterly art background texture -->
    <div
      class="absolute inset-0 bg-cover bg-center"
      style="background-image: url('/images/art-background.jpg');"
    ></div>

    <!-- Layer 2: Soft white wash overlay (matches original's rgba 0.34) -->
    <div class="absolute inset-0 bg-white/[.34]"></div>

    <!-- Layer 3: Subtle warm gradient for depth at edges -->
    <div class="absolute inset-0" style="background:
      radial-gradient(ellipse at 80% 20%, transparent 40%, rgba(255,255,255,0.3) 100%),
      linear-gradient(to bottom, transparent 60%, rgba(250,245,240,0.5) 100%);">
    </div>

    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12 w-full pt-28 pb-12 lg:pt-32 lg:pb-16">
      <div class="flex flex-col lg:flex-row items-end lg:items-center gap-6 lg:gap-8">

        <!-- Portrait — large, grounded at bottom, natural feel -->
        <div class="order-2 lg:order-1 flex-shrink-0 lg:w-[42%] self-end">
          <img
            src="/images/kellee-portrait-standing.png"
            alt="Kellee Wynne"
            class="w-72 sm:w-80 lg:w-full max-w-lg mx-auto lg:mx-0 drop-shadow-[0_8px_32px_rgba(0,0,0,0.15)]"
            loading="eager"
            style="margin-bottom: -2rem;"
          />
        </div>

        <!-- Text — right side, vertically centered -->
        <div class="order-1 lg:order-2 lg:w-[58%] text-center lg:text-left pt-8 lg:pt-0">
          <h1 class="font-display text-[2.5rem] sm:text-5xl lg:text-6xl xl:text-[4.5rem] text-brand-pink uppercase leading-[0.95] mb-6 tracking-tight">
            I'm so happy that you're here!
          </h1>
          <p class="font-semibold text-lg sm:text-xl lg:text-2xl text-brand-dark leading-snug mb-4 max-w-xl lg:max-w-none">
            Hey, Artists and Makers, Welcome to the place where your wild, weird and brilliant ideas come to life!
          </p>
          <p class="text-brand-dark/60 text-base sm:text-lg leading-relaxed mb-8 max-w-lg lg:max-w-none">
            I want to help you turn your talent into a profitable course business.
          </p>

          <!-- CTA — styled like original: outlined with pink accent -->
          <div class="flex flex-col sm:flex-row items-center lg:items-start gap-3">
            <a
              href="/priority"
              class="group relative inline-flex flex-col items-center bg-white/80 backdrop-blur-sm border-2 border-brand-dark px-10 py-4 rounded-lg hover:bg-brand-pink hover:border-brand-pink hover:text-white transition-all duration-300"
            >
              <span class="text-xs font-medium tracking-widest uppercase text-brand-dark/60 group-hover:text-white/80 transition-colors">
                Click Here to Learn About My Signature Program
              </span>
              <span class="font-display text-xl sm:text-2xl uppercase text-brand-dark group-hover:text-white transition-colors tracking-wide">
                Build It Remarkable
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       CONNECT — "3 Ways We Can Connect Right Now"
       Warm section with offerings cards
       ═══════════════════════════════════════════════════ -->
  <section class="relative py-20 sm:py-28 overflow-hidden bg-white">
    <div class="max-w-5xl mx-auto px-6 lg:px-10">
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-brand-dark text-center uppercase mb-4">
        Here are 3 Ways We Can Connect Right Now
      </h2>
      <div class="w-24 h-1 bg-brand-pink mx-auto mb-14 rounded-full"></div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
        <Card icon="🚀" title="Build It Remarkable" subtitle="Signature coaching program" href="/priority" />
        <Card icon="📋" title="100 Ways Free Guide" subtitle="Steal my best ideas" href="/100" />
        <Card icon="🎙️" title="Podcast" subtitle="Made Remarkable" href="/podcast" />
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       ABOUT — Meet Kellee, warm and personal
       Art background texture with portrait
       ═══════════════════════════════════════════════════ -->
  <section class="relative py-20 sm:py-28 overflow-hidden">
    <!-- Art background with stronger presence -->
    <div
      class="absolute inset-0 bg-cover bg-center opacity-20"
      style="background-image: url('/images/art-background.jpg');"
    ></div>
    <div class="absolute inset-0 bg-brand-warm/90"></div>

    <div class="relative z-10 max-w-6xl mx-auto px-6 lg:px-10">
      <div class="flex flex-col md:flex-row items-center gap-10 md:gap-16">
        <!-- Splat portrait — the artistic circular one with paint splatters -->
        <div class="flex-shrink-0">
          <img
            src="/images/kellee-splat-portrait.png"
            alt="Kellee Wynne"
            class="w-56 sm:w-72 drop-shadow-xl"
          />
        </div>
        <div>
          <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl uppercase mb-6 leading-tight text-brand-dark">
            Meet Kellee
          </h2>
          <p class="text-brand-dark/80 text-lg leading-relaxed mb-4">
            Artist, author of <em class="text-brand-pink font-semibold not-italic">Mixed Media Color Studio</em>,
            and business mentor for creative entrepreneurs.
          </p>
          <p class="text-brand-dark/60 text-base leading-relaxed mb-6">
            I've spent years helping artists and makers turn their wild, weird, and brilliant ideas
            into thriving creative businesses. Whether you're just starting out or ready to scale,
            I'm here to help you build something remarkable.
          </p>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 text-brand-pink font-semibold hover:gap-3 transition-all duration-300"
          >
            Get to know me
            <span class="text-lg">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       CTA — Bold, warm, action-oriented
       ═══════════════════════════════════════════════════ -->
  <CTA
    headline="Turn Your Creativity Into a Business"
    subtitle="Join the community of artists building something remarkable."
    buttonText="Start Here →"
    buttonHref="/contact"
  />

  <Footer />
</Layout>

<style>
  /* Fade-in animation for hero content */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  section:first-of-type h1 {
    animation: fadeInUp 0.8s ease-out both;
  }
  section:first-of-type p {
    animation: fadeInUp 0.8s ease-out 0.15s both;
  }
  section:first-of-type a {
    animation: fadeInUp 0.8s ease-out 0.3s both;
  }
  section:first-of-type img {
    animation: fadeInUp 1s ease-out 0.1s both;
  }
</style>
