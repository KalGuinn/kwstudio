---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import CallToAction from '../components/CallToAction.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Footer from '../components/Footer.astro';
import BrushDivider from '../components/BrushDivider.astro';

import artBackgroundSrc from '../assets/images/art-background.jpg';
import kelleePortraitStanding from '../assets/images/kellee-portrait-standing.png';
import buildItRemarkableLogo from '../assets/images/build-it-remarkable-logo.png';
import stealMyIdeasGraphics from '../assets/images/steal-my-ideas-graphics.png';
import kelleeSplatPortrait from '../assets/images/kellee-splat-portrait.png';

const artBackground = await getImage({ src: artBackgroundSrc });
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Kellee Wynne Studios — Artist, Author, Mentor" description="Kellee Wynne helps artists and makers turn their creative talent into profitable course businesses. Explore programs, grab the free guide, or listen to the podcast.">
  <Nav currentPage="/" />

  <!-- ═══════════════════════════════════════════════════
       HERO — Immersive, painterly, artist's welcome
       Warm ambient + bold entrance + polished details
       ═══════════════════════════════════════════════════ -->
  <section class="relative flex items-end -mt-20 pt-20 overflow-hidden" data-dark-overlay>
    <!-- Layer 1: Painterly art background with ambient breathing -->
    <div
      class="absolute inset-0 bg-cover bg-center ambient-bg"
      style={`background-image: url('${artBackground.src}');`}
    ></div>

    <!-- Layer 2: Soft white wash overlay -->
    <div class="absolute inset-0 bg-white/[.34] dark:bg-transparent"></div>

    <!-- Layer 3: Subtle warm gradient for depth at edges -->
    <div class="absolute inset-0" style="background:
      radial-gradient(ellipse at 80% 20%, transparent 40%, rgba(255,255,255,0.3) 100%),
      linear-gradient(to bottom, transparent 60%, rgba(250,245,240,0.5) 100%);">
    </div>

    <!-- Floating ambient blobs -->
    <div class="ambient-blob" style="width: 300px; height: 300px; background: rgba(242,48,106,0.08); top: 10%; left: -5%; animation: blobDrift1 18s ease-in-out infinite; z-index: 1;" aria-hidden="true"></div>
    <div class="ambient-blob" style="width: 250px; height: 250px; background: rgba(201,161,24,0.1); top: 30%; right: -3%; animation: blobDrift2 22s ease-in-out infinite; z-index: 1;" aria-hidden="true"></div>
    <div class="ambient-blob" style="width: 200px; height: 200px; background: rgba(253,247,242,0.3); bottom: 15%; left: 40%; animation: blobDrift3 25s ease-in-out infinite; z-index: 1;" aria-hidden="true"></div>

    <!-- Gold line extends on load -->
    <div class="gold-line" aria-hidden="true"></div>

    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12 w-full flex items-end">
      <div class="flex flex-col lg:flex-row items-end w-full gap-6 lg:gap-8">

        <!-- Portrait — dramatic entrance + warm glow -->
        <div class="order-2 lg:order-1 flex-shrink-0 lg:w-[48%] self-end relative">
          <div class="portrait-glow" aria-hidden="true"></div>
          <Image
            src={kelleePortraitStanding}
            alt="Kellee Wynne"
            class="portrait-entrance w-80 sm:w-96 lg:w-full lg:object-contain mx-auto lg:mx-0 drop-shadow-[0_16px_48px_rgba(0,0,0,0.2)] relative z-10"
            loading="eager"
            fetchpriority="high"
            style="object-position: bottom; display: block; margin-bottom: -1px;"
          />
        </div>

        <!-- Text — word-by-word headline + staggered content -->
        <div class="order-1 lg:order-2 lg:w-[52%] text-center lg:text-left pt-8 pb-6 lg:pb-8 lg:pt-0 self-center">
          <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl tracking-tight uppercase text-brand-pink leading-tight mb-6">
            <span class="word" style="animation-delay: 0s;">I'm</span>{" "}
            <span class="word" style="animation-delay: 0.1s;">so</span>{" "}
            <span class="word" style="animation-delay: 0.2s;">happy</span>{" "}
            <span class="word" style="animation-delay: 0.3s;">that</span>{" "}
            <span class="word" style="animation-delay: 0.4s;">you're</span>{" "}
            <span class="word" style="animation-delay: 0.5s;">here!</span>
          </h1>
          <p class="hero-text font-semibold text-lg sm:text-xl lg:text-2xl text-brand-dark leading-snug mb-4 max-w-xl lg:max-w-none" style="animation: fadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.7s forwards;">
            Hey, Artists and Makers, Welcome to the place where your wild, weird and brilliant ideas come to life!
          </p>
          <p class="hero-text-2 text-brand-dark/80 text-base sm:text-lg leading-relaxed mb-8 max-w-lg lg:max-w-none" style="animation: fadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.85s forwards;">
            I want to help you turn your talent into a profitable course business.
          </p>

          <div class="hero-cta flex flex-col sm:flex-row items-center lg:items-start gap-3" style="animation: fadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) 1s forwards;">
            <a href={`${base}/priority`} class="cta-shine bg-brand-gold text-brand-dark font-display uppercase tracking-widest px-10 py-4 rounded-lg shadow-lg">
              <span class="relative z-10">Build It Remarkable</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       CONNECT — "3 Ways We Can Connect Right Now"
       Polished card hovers with arrow reveals
       ═══════════════════════════════════════════════════ -->
  <section class="py-12 sm:py-16 bg-white">
    <div class="max-w-6xl mx-auto px-6 lg:px-10">
      <div data-reveal>
        <SectionHeading
          overline="Let's Connect"
          title="Here Are 3 Ways We Can Connect Right Now"
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8" data-reveal-stagger>

        <!-- Card 1: Build It Remarkable -->
        <a
          href={`${base}/priority`}
          class="polished-card group relative flex flex-col rounded-2xl overflow-hidden bg-brand-warm"
        >
          <div class="flex items-center justify-center bg-brand-dark px-6 aspect-video">
            <Image
              src={buildItRemarkableLogo}
              alt="Build It Remarkable"
              class="h-24 sm:h-20 lg:h-28 w-auto object-contain drop-shadow-md group-hover:scale-[1.03] transition-transform duration-500 bg-white/90 rounded-lg px-4 py-2"
              style="transition-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);"
              loading="lazy"
            />
          </div>
          <div class="flex flex-col flex-1 p-6 text-center">
            <h3 class="font-display text-xl uppercase text-brand-dark group-hover:text-brand-gold transition-colors duration-300 mb-2">
              Build It Remarkable
            </h3>
            <p class="text-sm text-brand-dark/80 leading-relaxed mb-4 flex-1">Our signature coaching program to help you turn your creative talent into a thriving course business.</p>
            <span class="card-arrow text-brand-gold text-sm font-semibold tracking-wide uppercase flex items-center justify-center gap-1">
              Learn More <span class="arrow-icon">&rarr;</span>
            </span>
          </div>
        </a>

        <!-- Card 2: 100 Ways Free Guide -->
        <a
          href={`${base}/free-guide`}
          class="polished-card group relative flex flex-col rounded-2xl overflow-hidden bg-brand-warm"
        >
          <div class="overflow-hidden aspect-video">
            <Image
              src={stealMyIdeasGraphics}
              alt="100 Ways to Steal My Ideas"
              class="w-full h-full object-cover object-top group-hover:scale-[1.03] transition-transform duration-500"
              style="transition-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);"
              loading="lazy"
            />
          </div>
          <div class="flex flex-col flex-1 p-6 text-center">
            <h3 class="font-display text-xl uppercase text-brand-dark group-hover:text-brand-gold transition-colors duration-300 mb-2">
              100 Ways Free Guide
            </h3>
            <p class="text-sm text-brand-dark/80 leading-relaxed mb-4 flex-1">Download the free guide packed with creative business ideas you can start using today.</p>
            <span class="card-arrow text-brand-gold text-sm font-semibold tracking-wide uppercase flex items-center justify-center gap-1">
              Get It Free <span class="arrow-icon">&rarr;</span>
            </span>
          </div>
        </a>

        <!-- Card 3: Podcast -->
        <a
          href={`${base}/podcast`}
          class="polished-card group relative flex flex-col rounded-2xl overflow-hidden bg-brand-warm"
        >
          <div class="flex items-center justify-center bg-brand-dark px-6 aspect-video">
            <div class="text-center">
              <div class="w-20 h-20 mx-auto mb-3 rounded-full bg-brand-orange/20 border-2 border-brand-orange flex items-center justify-center">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-10 h-10 text-brand-orange">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" />
                </svg>
              </div>
              <p class="font-accent text-brand-orange/80 text-base tracking-wider">Made Remarkable</p>
            </div>
          </div>
          <div class="flex flex-col flex-1 p-6 text-center">
            <h3 class="font-display text-xl uppercase text-brand-dark group-hover:text-brand-gold transition-colors duration-300 mb-2">
              Podcast
            </h3>
            <p class="text-sm text-brand-dark/80 leading-relaxed mb-4 flex-1">Listen to the podcast for real conversations about creativity, business, and showing up boldly.</p>
            <span class="card-arrow text-brand-gold text-sm font-semibold tracking-wide uppercase flex items-center justify-center gap-1">
              Listen Now <span class="arrow-icon">&rarr;</span>
            </span>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       ABOUT — Meet Kellee, warm and personal
       ═══════════════════════════════════════════════════ -->
  <section class="py-12 sm:py-16 bg-white">
    <div class="max-w-6xl mx-auto px-6 lg:px-10">
      <div class="flex flex-col md:flex-row items-center gap-6 md:gap-10">
        <!-- Splat portrait -->
        <div class="flex-shrink-0" data-reveal="left">
          <Image
            src={kelleeSplatPortrait}
            alt="Kellee Wynne"
            class="w-56 sm:w-72 drop-shadow-xl"
            loading="lazy"
          />
        </div>
        <div data-reveal="right">
          <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl uppercase text-brand-dark leading-tight mb-4">
            Meet Kellee
          </h2>
          <p class="text-brand-dark/80 text-lg leading-relaxed mb-4">
            Artist, author of <em class="text-brand-pink font-semibold not-italic">Mixed Media Color Studio</em>,
            and business mentor for creative entrepreneurs.
          </p>
          <p class="text-brand-dark/80 text-base leading-relaxed mb-6">
            I've spent years helping artists and makers turn their wild, weird, and brilliant ideas
            into thriving creative businesses. Whether you're just starting out or ready to scale,
            I'm here to help you build something remarkable.
          </p>
          <a
            href={`${base}/contact`}
            class="text-brand-pink font-semibold hover:text-brand-gold transition-colors duration-200 inline-flex items-center gap-1"
          >
            Get to know me
            <span class="arrow-icon">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       NEWSLETTER — Email signup for weekly notes
       ═══════════════════════════════════════════════════ -->
  <section class="relative py-12 sm:py-16 bg-brand-warm overflow-hidden">
    <!-- Subtle floating accents -->
    <div class="ambient-blob hidden sm:block" style="width: 280px; height: 280px; background: rgba(242,48,106,0.06); top: 20%; left: -8%; animation: blobDrift1 20s ease-in-out infinite;" aria-hidden="true"></div>
    <div class="ambient-blob hidden sm:block" style="width: 220px; height: 220px; background: rgba(201,161,24,0.08); bottom: 10%; right: -6%; animation: blobDrift2 24s ease-in-out infinite;" aria-hidden="true"></div>

    <div class="relative max-w-2xl mx-auto px-6 lg:px-10">
      <div data-reveal>
        <SectionHeading
          overline="Stay Connected"
          title="Join the Newsletter"
        />
      </div>

      <p class="text-brand-dark/80 text-base sm:text-lg leading-relaxed text-center mb-8" data-reveal>
        Sign up for Kellee's real talk about purpose, profit, and showing up like you mean it.
        Weekly(ish) notes to help artists grow their course creator business. Smart ideas,
        honest insights, and strategy grounded in real-life experience.
      </p>

      <form onsubmit="return false;" class="font-body space-y-4" data-reveal>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="newsletter-name" class="sr-only">First Name</label>
            <input
              type="text"
              id="newsletter-name"
              name="name"
              placeholder="First Name"
              required
              class="w-full px-5 py-4 rounded-xl border border-brand-gold/30 bg-white text-brand-dark placeholder:text-brand-dark/35 focus:outline-none focus:ring-2 focus:ring-brand-gold/50 focus:border-brand-gold transition"
            />
          </div>
          <div>
            <label for="newsletter-email" class="sr-only">Email Address</label>
            <input
              type="email"
              id="newsletter-email"
              name="email"
              placeholder="Email Address"
              required
              class="w-full px-5 py-4 rounded-xl border border-brand-gold/30 bg-white text-brand-dark placeholder:text-brand-dark/35 focus:outline-none focus:ring-2 focus:ring-brand-gold/50 focus:border-brand-gold transition"
            />
          </div>
        </div>
        <button
          type="submit"
          class="cta-shine w-full bg-brand-gold text-brand-dark font-display uppercase tracking-widest px-10 py-4 rounded-lg shadow-lg"
        >
          <span class="relative z-10">Sign Me Up!</span>
        </button>
      </form>

      <p class="font-accent italic text-sm text-brand-dark/80 text-center mt-6">
        Join 13,000+ smart creatives who are building their art course business with Kellee Wynne.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       CTA — Bold, warm, action-oriented
       ═══════════════════════════════════════════════════ -->
  <div data-reveal>
    <CallToAction
      headline="Turn Your Creativity Into a Business"
      subtitle="Join the community of artists building something remarkable."
      buttonText="Start Here →"
      buttonHref={`${base}/contact`}
    />
  </div>

  <Footer />
</Layout>
