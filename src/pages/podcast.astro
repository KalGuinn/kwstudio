---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import CallToAction from '../components/CallToAction.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Footer from '../components/Footer.astro';
import { Icon } from 'astro-icon/components';
import madeRemarkablePodcast from '../assets/images/made-remarkable-podcast.png';
import kelleeSplatPortrait from '../assets/images/kellee-splat-portrait.png';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const platforms = [
  {
    name: 'Apple Podcasts',
    icon: 'simple-icons:applepodcasts',
    href: 'https://podcasts.apple.com/us/podcast/made-remarkable/id1557387863',
    color: '#fc3c44',
    label: 'Listen on',
  },
  {
    name: 'Spotify',
    icon: 'simple-icons:spotify',
    href: 'https://open.spotify.com/show/2LuAIEd0DnKiVCXJFHJxhU',
    color: '#1db954',
    label: 'Listen on',
  },
  {
    name: 'YouTube',
    icon: 'simple-icons:youtube',
    href: 'https://www.youtube.com/c/kelleewynne',
    color: '#ff0000',
    label: 'Watch on',
  },
  {
    name: 'Listen on the Web',
    icon: 'simple-icons:rss',
    href: 'https://www.maderemarkable.com/blog',
    color: '#e6b81d',
    label: 'Or',
  },
];
---

<Layout
  title="Made Remarkable Podcast"
  description="Made Remarkable — a podcast by Kellee Wynne about creative entrepreneurship, artist interviews, and building a remarkable business."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "PodcastSeries",
      "name": "Made Remarkable",
      "description": "Real conversations about building a creative business, the messy middle of being an artist-entrepreneur, and what it truly means to make something remarkable.",
      "url": "https://www.maderemarkable.com",
      "author": {
        "@type": "Person",
        "name": "Kellee Wynne"
      },
      "image": new URL(madeRemarkablePodcast.src, 'https://www.kelleewynne.com').href,
      "webFeed": "https://www.maderemarkable.com/blog"
    })} />
  </Fragment>
  <Nav currentPage="/podcast" />

  <!-- ═══════════════════════════════════════════════════
       HERO — Warm, painterly, with podcast artwork
       Matches site's warm theme while feeling distinct
       ═══════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden -mt-20 bg-brand-warm">
    <!-- Painterly warmth overlays -->
    <div class="absolute inset-0 pointer-events-none" style="background:
      radial-gradient(ellipse at 20% 40%, rgba(242,48,106,0.07) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 60%, rgba(201,161,24,0.08) 0%, transparent 45%),
      radial-gradient(ellipse at 50% 90%, rgba(240,72,31,0.05) 0%, transparent 40%);">
    </div>
    <!-- Bottom fade -->
    <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-white to-transparent pointer-events-none"></div>

    <!-- Content -->
    <div class="relative z-10 max-w-6xl mx-auto px-6 lg:px-12 w-full pt-28 pb-14">
      <div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-12">

        <!-- Left: Text content -->
        <div class="lg:w-[55%] text-center lg:text-left">
          <p class="text-xs sm:text-sm font-semibold tracking-[0.2em] text-brand-pink uppercase mb-4 hero-item">
            The Podcast
          </p>

          <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl xl:text-8xl text-brand-pink uppercase leading-[0.9] mb-6 tracking-tight hero-item">
            <span class="word" style="animation-delay: 0s;">Made</span><br />
            <span class="word" style="animation-delay: 0.15s;">Remarkable</span>
          </h1>

          <p class="font-accent text-xl sm:text-2xl text-brand-dark/70 mb-4 italic hero-item">
            with Kellee Wynne
          </p>

          <p class="font-body text-base sm:text-lg text-brand-dark/80 max-w-xl leading-relaxed mb-8 hero-item">
            Real conversations about building a creative business, the messy middle of being an artist-entrepreneur,
            and what it truly means to make something remarkable.
          </p>

          <div class="hero-item">
            <a
              href="https://www.maderemarkable.com/blog"
              target="_blank"
              rel="noopener noreferrer"
              class="cta-shine inline-block bg-brand-gold text-brand-dark font-display uppercase tracking-widest px-10 py-4 rounded-lg shadow-lg hover:brightness-110 hover:shadow-xl hover:-translate-y-0.5 hover:scale-[1.02] transition-all duration-300"
            >
              <span class="relative z-10">Listen Now</span>
            </a>
          </div>
        </div>

        <!-- Right: Podcast artwork -->
        <div class="lg:w-[45%] hero-item">
          <Image
            src={madeRemarkablePodcast}
            alt="Made Remarkable Podcast"
            class="portrait-entrance w-64 sm:w-80 lg:w-full max-w-sm mx-auto rounded-2xl shadow-2xl"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       ABOUT THE SHOW — Warm, personal, editorial
       ═══════════════════════════════════════════════════ -->
  <section class="bg-white py-12 sm:py-16">
    <div class="max-w-5xl mx-auto px-6 lg:px-12">
      <div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-12">

        <!-- Kellee portrait -->
        <div class="flex-shrink-0 text-center lg:text-left" data-reveal="left">
          <Image
            src={kelleeSplatPortrait}
            alt="Kellee Wynne"
            class="w-52 sm:w-64 drop-shadow-xl mx-auto lg:mx-0"
            loading="lazy"
          />
        </div>

        <!-- Text -->
        <div data-reveal="right">
          <p class="text-xs font-semibold tracking-[0.18em] text-brand-orange uppercase mb-3">
            About the Show
          </p>
          <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-brand-dark uppercase leading-tight mb-6">
            For the Artist Who<br />
            <span class="text-brand-pink">Dares to Dream Big</span>
          </h2>
          <p class="text-brand-dark/80 text-base sm:text-lg leading-relaxed mb-4">
            Made Remarkable is a podcast for creative entrepreneurs — artists, makers, and visionaries
            who are building businesses around the work they love.
          </p>
          <p class="text-brand-dark/80 text-base leading-relaxed mb-4">
            Each episode dives into the real, unfiltered side of creative business: the strategies that
            actually work, the mindset shifts that change everything, and the stories of artists who
            chose to bet on themselves.
          </p>
          <p class="text-brand-dark/80 text-base leading-relaxed mb-8">
            Hosted by Kellee Wynne — artist, author, and mentor — who has helped hundreds of creatives
            turn their passion into a profitable, purpose-driven business.
          </p>
          <div class="flex flex-wrap gap-3">
            {['Creative Entrepreneurship', 'Artist Interviews', 'Business Strategy', 'Mindset & Growth'].map((tag) => (
              <span class="text-xs font-semibold tracking-wider uppercase px-4 py-2 rounded-full border border-brand-dark/20 text-brand-dark/70 bg-white/60">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       WHERE TO LISTEN — Platform grid
       ═══════════════════════════════════════════════════ -->
  <section class="py-12 sm:py-16 bg-brand-warm">
    <div class="max-w-4xl mx-auto px-6 lg:px-12 text-center">
      <div data-reveal>
        <SectionHeading overline="Available Everywhere" title="Where to Listen" />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5" data-reveal-stagger>
        {platforms.map((platform) => (
          <a
            href={platform.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-5 bg-white rounded-xl border border-brand-dark/10 px-7 py-6 polished-card text-left"
          >
            <div
              class="flex-shrink-0 w-12 h-12 rounded-full flex items-center justify-center text-white transition-transform duration-300 group-hover:scale-110"
              style={`background-color: ${platform.color};`}
            >
              <Icon name={platform.icon} class="w-5 h-5" />
            </div>
            <div>
              <p class="text-xs font-medium tracking-widest uppercase text-brand-dark/50 mb-0.5">
                {platform.label}
              </p>
              <p class="font-display text-lg sm:text-xl uppercase text-brand-dark group-hover:text-brand-pink transition-colors duration-300">
                {platform.name}
              </p>
            </div>
            <span class="ml-auto text-brand-dark/20 group-hover:text-brand-pink group-hover:translate-x-1 transition-all duration-300 text-xl">
              →
            </span>
          </a>
        ))}
      </div>

      <p class="mt-6 text-sm text-brand-dark/60 font-body">
        New episodes drop regularly. Subscribe so you never miss one.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       QUOTE / PULL — Editorial moment before CTA
       ═══════════════════════════════════════════════════ -->
  <section class="py-12 sm:py-16 bg-white">
    <div class="max-w-3xl mx-auto px-6 lg:px-12 text-center" data-reveal>
      <blockquote class="border-l-4 border-brand-gold pl-6 text-left">
        <p class="font-accent text-2xl sm:text-3xl lg:text-4xl italic text-brand-dark leading-relaxed mb-6">
          "You were made for more than ordinary.<br />
          <span class="text-brand-gold">Go make something remarkable."</span>
        </p>
        <p class="text-brand-dark/50 text-sm tracking-widest uppercase font-semibold">— Kellee Wynne</p>
      </blockquote>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       CTA — Drive to business mentorship
       ═══════════════════════════════════════════════════ -->
  <div data-reveal>
    <CallToAction
      headline="Ready to Build Your Creative Business?"
      subtitle="Join the artists and makers turning their passion into profit — one remarkable step at a time."
      buttonText="Work With Kellee →"
      buttonHref={`${base}/contact`}
      variant="dark"
    />
  </div>

  <Footer />
</Layout>

<style>
  .hero-item {
    animation: fadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .hero-item:nth-child(1) { animation-delay: 0.0s; }
  .hero-item:nth-child(2) { animation-delay: 0.1s; }
  .hero-item:nth-child(3) { animation-delay: 0.2s; }
  .hero-item:nth-child(4) { animation-delay: 0.3s; }
  .hero-item:nth-child(5) { animation-delay: 0.4s; }

  /* @keyframes fadeInUp is defined globally in Layout */
</style>
