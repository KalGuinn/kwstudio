---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BrushDivider from '../components/BrushDivider.astro';

import bookCover from '../assets/images/book-cover.jpg';
import bookBannerSrc from '../assets/images/book-banner.jpg';

const bookBanner = await getImage({ src: bookBannerSrc });
const bookCoverUrl = new URL(bookCover.src, 'https://www.kelleewynne.com').href;
---

<Layout title="The Book" description="Mixed Media Color Studio by Kellee Wynne Conrad">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Book",
      "name": "Mixed Media Color Studio",
      "author": {
        "@type": "Person",
        "name": "Kellee Wynne Conrad"
      },
      "isbn": "9781631599965",
      "publisher": {
        "@type": "Organization",
        "name": "Quarry Books"
      },
      "description": "Explore color theory and mixed media techniques with colorful projects, creative exercises, and full-color examples.",
      "image": bookCoverUrl,
      "url": "https://www.kelleewynne.com/book"
    })} />
  </Fragment>
  <Nav currentPage="/book" />

  <!-- ═══════════════════════════════════════════════════
       HERO — Warm peach-to-cream gradient + dramatic book cover
       ═══════════════════════════════════════════════════ -->
  <section class="relative flex items-center overflow-hidden -mt-20 bg-brand-warm pt-24 sm:pt-28 pb-12">
    <!-- Painterly warmth overlays for visual texture -->
    <div class="absolute inset-0 pointer-events-none" style="background:
      radial-gradient(ellipse at 20% 40%, rgba(242,48,106,0.05) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 60%, rgba(201,161,24,0.06) 0%, transparent 45%);">
    </div>
    <!-- Content -->
    <div class="max-w-5xl mx-auto px-6 lg:px-12 w-full">
      <div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-10">

        <!-- Book cover — large, rotated, dramatic shadow -->
        <div class="flex-shrink-0 book-cover-wrap">
          <Image
            src={bookCover}
            alt="Mixed Media Color Studio by Kellee Wynne Conrad"
            class="portrait-entrance w-64 sm:w-80 lg:w-96 rounded-lg shadow-2xl hover:scale-[1.02] transition-transform duration-300"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <!-- Text block -->
        <div class="text-center lg:text-left max-w-lg">
          <p class="text-xs sm:text-sm font-medium tracking-[0.18em] text-brand-pink uppercase mb-4">
            The Book
          </p>
          <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl tracking-tight uppercase text-brand-pink leading-tight mb-6">
            <span class="word" style="animation-delay: 0s;">Mixed</span>{" "}
            <span class="word" style="animation-delay: 0.1s;">Media</span><br />
            <span class="word" style="animation-delay: 0.25s;">Color</span>{" "}
            <span class="word" style="animation-delay: 0.35s;">Studio</span>
          </h1>
          <p class="hero-text text-brand-dark/80 text-base sm:text-lg leading-relaxed mb-3 font-medium" style="animation: fadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.5s forwards;">
            by Kellee Wynne Conrad
          </p>
          <p class="hero-text-2 text-brand-dark/80 text-base leading-relaxed mb-6" style="animation: fadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.65s forwards;">
            A hands-on journey through color, texture, and mixed media — packed with techniques,
            creative exercises, and full-color inspiration to unlock your artistic voice.
          </p>

          <!-- Purchase buttons -->
          <div class="hero-cta flex flex-col sm:flex-row items-center lg:items-start justify-center lg:justify-start gap-4" style="animation: fadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.8s forwards;">
            <a
              href="https://amazon.com/dp/1631599968"
              class="cta-shine bg-brand-gold text-brand-dark font-display uppercase tracking-widest px-10 py-4 rounded-lg shadow-lg hover:brightness-110 hover:shadow-xl hover:-translate-y-0.5 hover:scale-[1.02] transition-all duration-300"
            >
              <span class="relative z-10">Buy on Amazon</span>
            </a>
            <a
              href="#"
              class="border-2 border-brand-gold text-brand-gold font-display uppercase tracking-widest px-10 py-4 rounded-lg hover:bg-brand-gold hover:text-brand-dark hover:scale-[1.02] transition-all duration-300"
            >
              Bookshop.org
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Brush stroke divider between hero and book content -->
  <BrushDivider color="pink" />

  <!-- ═══════════════════════════════════════════════════
       BOOK BANNER — Full-width immersive section break
       ═══════════════════════════════════════════════════ -->
  <div class="relative h-56 sm:h-72 lg:h-80 overflow-hidden" data-reveal="scale" aria-hidden="true">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style={`background-image: url('${bookBanner.src}'); background-position: center 40%;`}
    ></div>
    <!-- Subtle warm overlay for continuity -->
    <div class="absolute inset-0 bg-brand-dark/30"></div>
    <!-- Fade top and bottom edges into surrounding sections -->
    <div class="absolute inset-x-0 top-0 h-16 bg-gradient-to-b from-brand-warm/60 to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-brand-warm/60 to-transparent"></div>
  </div>

  <!-- ═══════════════════════════════════════════════════
       WHAT'S INSIDE — Warm section with radial accent
       ═══════════════════════════════════════════════════ -->
  <section class="relative py-12 sm:py-16 bg-brand-warm overflow-hidden">
    <!-- Subtle warmth overlay -->
    <div class="absolute inset-0 pointer-events-none" style="background:
      radial-gradient(ellipse at 75% 25%, rgba(201,161,24,0.04) 0%, transparent 45%),
      radial-gradient(ellipse at 25% 75%, rgba(242,48,106,0.03) 0%, transparent 50%);">
    </div>
    <div class="relative z-10 max-w-4xl mx-auto px-6 lg:px-10">
      <div data-reveal>
        <p class="text-xs sm:text-sm font-medium tracking-[0.18em] text-brand-pink uppercase text-center mb-3">
          Inside the Pages
        </p>
        <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl uppercase text-brand-dark leading-tight mb-4 text-center">
          What's Inside
        </h2>
        <div class="w-16 h-1 bg-brand-gold mx-auto mb-8 rounded-full"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5" data-reveal-stagger>

        <!-- Card 1 -->
        <div class="group bg-white/80 backdrop-blur-sm border border-brand-gold/20 rounded-xl p-6 polished-card">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-brand-gold/10 flex items-center justify-center">
              <span class="text-brand-gold font-display text-lg">01</span>
            </div>
            <div>
              <h3 class="font-display text-lg text-brand-dark uppercase tracking-wide mb-1">Color Theory &amp; Mixing</h3>
              <p class="text-brand-dark/80 text-sm leading-relaxed">Build confidence with color from the ground up — mixing palettes you'll actually use.</p>
            </div>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="group bg-white/80 backdrop-blur-sm border border-brand-gold/20 rounded-xl p-6 polished-card">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-brand-pink/10 flex items-center justify-center">
              <span class="text-brand-pink font-display text-lg">02</span>
            </div>
            <div>
              <h3 class="font-display text-lg text-brand-dark uppercase tracking-wide mb-1">Mixed Media Techniques</h3>
              <p class="text-brand-dark/80 text-sm leading-relaxed">Layer paint, collage, ink, and more — learn to combine media with intention and joy.</p>
            </div>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="group bg-white/80 backdrop-blur-sm border border-brand-gold/20 rounded-xl p-6 polished-card">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-brand-orange/10 flex items-center justify-center">
              <span class="text-brand-orange font-display text-lg">03</span>
            </div>
            <div>
              <h3 class="font-display text-lg text-brand-dark uppercase tracking-wide mb-1">Creative Exercises</h3>
              <p class="text-brand-dark/80 text-sm leading-relaxed">Guided prompts and projects to break through blocks and ignite your creative practice.</p>
            </div>
          </div>
        </div>

        <!-- Card 4 -->
        <div class="group bg-white/80 backdrop-blur-sm border border-brand-gold/20 rounded-xl p-6 polished-card">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-brand-gold/10 flex items-center justify-center">
              <span class="text-brand-gold font-display text-lg">04</span>
            </div>
            <div>
              <h3 class="font-display text-lg text-brand-dark uppercase tracking-wide mb-1">Full-Color Examples</h3>
              <p class="text-brand-dark/80 text-sm leading-relaxed">Gorgeous photography and finished artwork throughout — a feast for the eyes and the imagination.</p>
            </div>
          </div>
        </div>

      </div>

      <!-- Secondary purchase nudge inside section -->
      <div class="text-center mt-8" data-reveal>
        <p class="text-brand-dark/80 text-sm mb-5 italic">Ready to dive in?</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="https://amazon.com/dp/1631599968"
            class="cta-shine bg-brand-gold text-brand-dark font-display uppercase tracking-widest px-10 py-4 rounded-lg shadow-lg hover:brightness-110 hover:shadow-xl hover:-translate-y-0.5 hover:scale-[1.02] transition-all duration-300"
          >
            <span class="relative z-10">Buy on Amazon</span>
          </a>
          <a
            href="#"
            class="border-2 border-brand-gold text-brand-gold font-display uppercase tracking-widest px-10 py-4 rounded-lg hover:bg-brand-gold hover:text-brand-dark hover:scale-[1.02] transition-all duration-300"
          >
            Bookshop.org
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       THANK YOU — Intimate, handwritten feel with font-accent
       ═══════════════════════════════════════════════════ -->
  <section class="relative py-12 sm:py-16 bg-white overflow-hidden">
    <!-- Subtle paint splatter accent for the Thank You section -->
    <div class="absolute -right-8 top-1/4 w-32 h-32 rounded-full bg-brand-pink/[0.07] blur-2xl pointer-events-none hidden sm:block" aria-hidden="true"></div>

    <div class="relative max-w-2xl mx-auto px-6 lg:px-10 text-center" data-reveal>
      <!-- Gold decorative rule -->
      <div class="flex items-center justify-center gap-4 mb-8">
        <div class="h-px w-16 bg-brand-gold/50"></div>
        <div class="w-2 h-2 rounded-full bg-brand-gold"></div>
        <div class="h-px w-16 bg-brand-gold/50"></div>
      </div>

      <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl uppercase text-brand-dark leading-tight mb-4">
        Thank You
      </h2>

      <!-- The heartfelt message in font-accent for intimacy -->
      <p class="font-accent text-lg sm:text-xl lg:text-2xl text-brand-dark/80 leading-relaxed mb-6">
        Every time you buy and share the book I do a happy dance!
      </p>
      <p class="font-accent text-lg sm:text-xl lg:text-2xl text-brand-dark/80 leading-relaxed mb-8">
        It brings me so much joy that you are finding joy in what I have created for you.
        It makes it worth the effort and long days to create something valuable for artists
        to enjoy for years to come.
      </p>
      <p class="font-accent text-lg sm:text-xl lg:text-2xl text-brand-pink leading-relaxed">
        Thank you from the whole of my heart!!
      </p>

      <!-- Closing flourish -->
      <div class="flex items-center justify-center gap-4 mt-10">
        <div class="h-px w-16 bg-brand-pink/30"></div>
        <div class="w-2 h-2 rounded-full bg-brand-pink/50"></div>
        <div class="h-px w-16 bg-brand-pink/30"></div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Book cover: slight tilt + dramatic layered shadow */
  .book-cover-wrap img {
    transform: rotate(1.5deg);
    box-shadow:
      0 4px 6px rgba(0, 0, 0, 0.07),
      0 12px 28px rgba(0, 0, 0, 0.18),
      0 32px 60px rgba(0, 0, 0, 0.14);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .book-cover-wrap:hover img {
    transform: rotate(0.5deg) scale(1.02);
    box-shadow:
      0 4px 6px rgba(0, 0, 0, 0.08),
      0 16px 36px rgba(0, 0, 0, 0.22),
      0 40px 70px rgba(0, 0, 0, 0.16);
  }

  /* Hero fade-in — @keyframes fadeInUp is defined globally in Layout */
  section:first-of-type h1 {
    animation: fadeInUp 0.8s ease-out 0.1s both;
  }
  section:first-of-type p {
    animation: fadeInUp 0.8s ease-out 0.2s both;
  }
  section:first-of-type a {
    animation: fadeInUp 0.8s ease-out 0.35s both;
  }
  .book-cover-wrap {
    animation: fadeInUp 1s ease-out 0.05s both;
  }
</style>
