---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="The Book" description="Mixed Media Color Studio by Kellee Wynne Conrad">
  <Nav currentPage="/book" />

  <!-- ═══════════════════════════════════════════════════
       HERO — Warm peach-to-cream gradient + dramatic book cover
       ═══════════════════════════════════════════════════ -->
  <section class="relative min-h-[85vh] flex items-center overflow-hidden -mt-20">
    <!-- Layer 1: Warm peach-to-cream gradient (no art texture) -->
    <div
      class="absolute inset-0"
      style="background: linear-gradient(135deg, #f9e8da 0%, #fdf5ee 45%, #fff8f2 100%);"
    ></div>

    <!-- Layer 2: Soft radial bloom — golden warmth from behind the book -->
    <div
      class="absolute inset-0"
      style="background: radial-gradient(ellipse at 30% 55%, rgba(230,184,29,0.12) 0%, transparent 55%), radial-gradient(ellipse at 80% 20%, rgba(254,54,118,0.07) 0%, transparent 50%);"
    ></div>

    <!-- Layer 3: Subtle bottom fade into next section -->
    <div
      class="absolute inset-x-0 bottom-0 h-20"
      style="background: linear-gradient(to bottom, transparent, rgba(253,245,238,0.7));"
    ></div>

    <!-- Content -->
    <div class="relative z-10 max-w-5xl mx-auto px-6 lg:px-12 w-full pt-32 pb-16 lg:pt-36 lg:pb-20">
      <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">

        <!-- Book cover — large, rotated, dramatic shadow -->
        <div class="flex-shrink-0 book-cover-wrap">
          <img
            src="/images/book-cover.jpg"
            alt="Mixed Media Color Studio by Kellee Wynne Conrad"
            class="w-64 sm:w-80 lg:w-96 rounded-lg"
            loading="eager"
          />
        </div>

        <!-- Text block -->
        <div class="text-center lg:text-left max-w-lg">
          <p class="text-xs sm:text-sm font-medium tracking-[0.18em] text-brand-pink uppercase mb-4">
            The Book
          </p>
          <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl text-brand-dark uppercase leading-tight mb-6">
            Mixed Media<br />Color Studio
          </h1>
          <p class="text-brand-dark/70 text-base sm:text-lg leading-relaxed mb-3 font-medium">
            by Kellee Wynne Conrad
          </p>
          <p class="text-brand-dark/60 text-base leading-relaxed mb-10">
            A hands-on journey through color, texture, and mixed media — packed with techniques,
            creative exercises, and full-color inspiration to unlock your artistic voice.
          </p>

          <!-- Purchase buttons — gold, premium feel -->
          <div class="flex flex-col sm:flex-row items-center lg:items-start justify-center lg:justify-start gap-4">
            <a
              href="#"
              class="inline-block bg-brand-gold text-white font-display text-sm tracking-[0.1em] uppercase px-9 py-3.5 rounded-full shadow-lg hover:brightness-105 hover:shadow-xl transition-all duration-300"
            >
              Buy on Amazon
            </a>
            <a
              href="#"
              class="inline-block bg-white/70 backdrop-blur-sm border-2 border-brand-gold text-brand-dark font-display text-sm tracking-[0.1em] uppercase px-9 py-3.5 rounded-full hover:bg-brand-gold hover:text-white hover:border-brand-gold transition-all duration-300"
            >
              Bookshop.org
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       BOOK BANNER — Full-width immersive section break
       ═══════════════════════════════════════════════════ -->
  <div class="relative h-56 sm:h-72 lg:h-80 overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style="background-image: url('/images/book-banner.jpg'); background-position: center 40%;"
    ></div>
    <!-- Subtle warm overlay for continuity -->
    <div class="absolute inset-0 bg-brand-dark/30"></div>
    <!-- Fade top and bottom edges into surrounding sections -->
    <div class="absolute inset-x-0 top-0 h-16 bg-gradient-to-b from-brand-warm/60 to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-brand-warm/60 to-transparent"></div>
  </div>

  <!-- ═══════════════════════════════════════════════════
       WHAT'S INSIDE — Warm section with radial accent
       ═══════════════════════════════════════════════════ -->
  <section class="relative py-20 sm:py-24 overflow-hidden">
    <!-- Solid warm with subtle radial gold accent — no art texture -->
    <div class="absolute inset-0 bg-brand-warm"></div>
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: radial-gradient(ellipse at 90% 10%, rgba(230,184,29,0.10) 0%, transparent 50%), radial-gradient(ellipse at 5% 90%, rgba(254,54,118,0.06) 0%, transparent 45%);"
    ></div>

    <div class="relative z-10 max-w-4xl mx-auto px-6 lg:px-10">
      <p class="text-xs sm:text-sm font-medium tracking-[0.18em] text-brand-pink uppercase text-center mb-3">
        Inside the Pages
      </p>
      <h2 class="font-display text-3xl sm:text-4xl text-brand-dark text-center uppercase mb-3">
        What's Inside
      </h2>
      <div class="w-16 h-1 bg-brand-gold mx-auto mb-12 rounded-full"></div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

        <!-- Card 1 -->
        <div class="group bg-white/80 backdrop-blur-sm border border-brand-gold/20 rounded-xl p-6 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-brand-gold/10 flex items-center justify-center">
              <span class="text-brand-gold font-display text-lg">01</span>
            </div>
            <div>
              <h3 class="font-display text-lg text-brand-dark uppercase tracking-wide mb-1">Color Theory &amp; Mixing</h3>
              <p class="text-brand-dark/60 text-sm leading-relaxed">Build confidence with color from the ground up — mixing palettes you'll actually use.</p>
            </div>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="group bg-white/80 backdrop-blur-sm border border-brand-gold/20 rounded-xl p-6 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-brand-pink/10 flex items-center justify-center">
              <span class="text-brand-pink font-display text-lg">02</span>
            </div>
            <div>
              <h3 class="font-display text-lg text-brand-dark uppercase tracking-wide mb-1">Mixed Media Techniques</h3>
              <p class="text-brand-dark/60 text-sm leading-relaxed">Layer paint, collage, ink, and more — learn to combine media with intention and joy.</p>
            </div>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="group bg-white/80 backdrop-blur-sm border border-brand-gold/20 rounded-xl p-6 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-brand-orange/10 flex items-center justify-center">
              <span class="text-brand-orange font-display text-lg">03</span>
            </div>
            <div>
              <h3 class="font-display text-lg text-brand-dark uppercase tracking-wide mb-1">Creative Exercises</h3>
              <p class="text-brand-dark/60 text-sm leading-relaxed">Guided prompts and projects to break through blocks and ignite your creative practice.</p>
            </div>
          </div>
        </div>

        <!-- Card 4 -->
        <div class="group bg-white/80 backdrop-blur-sm border border-brand-gold/20 rounded-xl p-6 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-brand-gold/10 flex items-center justify-center">
              <span class="text-brand-gold font-display text-lg">04</span>
            </div>
            <div>
              <h3 class="font-display text-lg text-brand-dark uppercase tracking-wide mb-1">Full-Color Examples</h3>
              <p class="text-brand-dark/60 text-sm leading-relaxed">Gorgeous photography and finished artwork throughout — a feast for the eyes and the imagination.</p>
            </div>
          </div>
        </div>

      </div>

      <!-- Secondary purchase nudge inside section -->
      <div class="text-center mt-12">
        <p class="text-brand-dark/50 text-sm mb-5 italic">Ready to dive in?</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="#"
            class="inline-block bg-brand-gold text-white font-display text-sm tracking-[0.1em] uppercase px-9 py-3.5 rounded-full shadow-md hover:brightness-105 hover:shadow-lg transition-all duration-300"
          >
            Buy on Amazon
          </a>
          <a
            href="#"
            class="inline-block border-2 border-brand-gold text-brand-dark font-display text-sm tracking-[0.1em] uppercase px-9 py-3.5 rounded-full hover:bg-brand-gold hover:text-white transition-all duration-300"
          >
            Bookshop.org
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       THANK YOU — Intimate, handwritten feel with font-accent
       ═══════════════════════════════════════════════════ -->
  <section class="relative py-20 sm:py-28 overflow-hidden bg-white">
    <!-- Soft radial pink bloom in corners — no art texture -->
    <div
      class="absolute top-0 right-0 w-96 h-96 rounded-bl-full pointer-events-none"
      style="background: radial-gradient(ellipse at top right, rgba(254,54,118,0.06) 0%, transparent 70%);"
    ></div>
    <div
      class="absolute bottom-0 left-0 w-64 h-64 rounded-tr-full pointer-events-none"
      style="background: radial-gradient(ellipse at bottom left, rgba(230,184,29,0.07) 0%, transparent 70%);"
    ></div>

    <div class="relative z-10 max-w-2xl mx-auto px-6 lg:px-10 text-center">
      <!-- Gold decorative rule -->
      <div class="flex items-center justify-center gap-4 mb-8">
        <div class="h-px w-16 bg-brand-gold/50"></div>
        <div class="w-2 h-2 rounded-full bg-brand-gold"></div>
        <div class="h-px w-16 bg-brand-gold/50"></div>
      </div>

      <h2 class="font-display text-3xl sm:text-4xl text-brand-dark uppercase mb-6 tracking-wide">
        Thank You
      </h2>

      <!-- The heartfelt message in font-accent for intimacy -->
      <p class="font-accent text-xl sm:text-2xl text-brand-dark/80 leading-relaxed mb-6">
        Every time you buy and share the book I do a happy dance!
      </p>
      <p class="font-accent text-lg sm:text-xl text-brand-dark/60 leading-relaxed mb-8">
        It brings me so much joy that you are finding joy in what I have created for you.
        It makes it worth the effort and long days to create something valuable for artists
        to enjoy for years to come.
      </p>
      <p class="font-accent text-xl sm:text-2xl text-brand-pink leading-relaxed">
        Thank you from the whole of my heart!!
      </p>

      <!-- Closing flourish -->
      <div class="flex items-center justify-center gap-4 mt-10">
        <div class="h-px w-16 bg-brand-pink/30"></div>
        <div class="w-2 h-2 rounded-full bg-brand-pink/50"></div>
        <div class="h-px w-16 bg-brand-pink/30"></div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Book cover: slight tilt + dramatic layered shadow */
  .book-cover-wrap img {
    transform: rotate(1.5deg);
    box-shadow:
      0 4px 6px rgba(0, 0, 0, 0.07),
      0 12px 28px rgba(0, 0, 0, 0.18),
      0 32px 60px rgba(0, 0, 0, 0.14);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .book-cover-wrap:hover img {
    transform: rotate(0.5deg) scale(1.02);
    box-shadow:
      0 4px 6px rgba(0, 0, 0, 0.08),
      0 16px 36px rgba(0, 0, 0, 0.22),
      0 40px 70px rgba(0, 0, 0, 0.16);
  }

  /* Hero fade-in */
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(1.25rem); }
    to   { opacity: 1; transform: translateY(0); }
  }

  section:first-of-type h1 {
    animation: fadeInUp 0.8s ease-out 0.1s both;
  }
  section:first-of-type p {
    animation: fadeInUp 0.8s ease-out 0.2s both;
  }
  section:first-of-type a {
    animation: fadeInUp 0.8s ease-out 0.35s both;
  }
  .book-cover-wrap {
    animation: fadeInUp 1s ease-out 0.05s both;
  }
</style>
