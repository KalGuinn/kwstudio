---
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = 'Kellee Wynne Studios — Artist, Author, Mentor', ogImage } = Astro.props;
const defaultOgImage = new URL(import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'og-default.jpg', Astro.site).href;
const resolvedOgImage = ogImage || defaultOgImage;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | Kellee Wynne Studios`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kellee Wynne Studios" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Kellee Wynne Studios`} />
    <meta name="twitter:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Montserrat:wght@400;500;600;700&family=Cactus+Classical+Serif&display=swap"
      rel="stylesheet"
    />
    <title>{title} | Kellee Wynne Studios</title>
    <ViewTransitions />
    <!-- Dark mode init — runs before paint to prevent flash -->
    <script is:inline>
      // Apply on initial load
      (function() {
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
      // Re-apply after View Transitions swap the DOM
      document.addEventListener('astro:after-swap', function() {
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      });
    </script>
    <!-- Global Organization structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Kellee Wynne Studios",
      "url": new URL(import.meta.env.BASE_URL, Astro.site).href,
      "logo": new URL(import.meta.env.BASE_URL + 'favicon.svg', Astro.site).href,
      "sameAs": [
        "https://www.instagram.com/kelleewynne",
        "https://www.youtube.com/c/kelleewynne",
        "https://www.pinterest.com/kelleewynne/"
      ],
      "description": "Kellee Wynne helps artists and makers turn their creative talent into profitable course businesses."
    })} />
    <!-- Page-specific head content (structured data, etc.) -->
    <slot name="head" />
  </head>
  <body class="font-body text-brand-dark bg-white antialiased scroll-pt-20 text-[17px]">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:z-[100] focus:top-4 focus:left-4 focus:bg-white focus:text-brand-dark focus:px-4 focus:py-2 focus:rounded-lg focus:shadow-lg">
      Skip to main content
    </a>
    <!-- Pages can add transition:name="page-title" to h1 elements for smooth cross-page transitions -->
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>

<script>
  // Dark mode toggle — re-registers after View Transitions
  document.addEventListener('astro:page-load', () => {
    (window as any).toggleDarkMode = () => {
      const html = document.documentElement;
      html.classList.toggle('dark');
      localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
    };
  });
</script>

<script>
  // Scroll reveal observer — runs on initial load and after View Transition navigations
  function initScrollReveal() {
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -60px 0px' });

    document.querySelectorAll('[data-reveal], [data-reveal-stagger]').forEach(el => {
      revealObserver.observe(el);
    });
  }

  // Use astro:page-load so it re-runs after View Transitions
  document.addEventListener('astro:page-load', initScrollReveal);
</script>

<style is:global>
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(1.25rem); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeInLeft {
    from { opacity: 0; transform: translateX(-1.5rem); }
    to { opacity: 1; transform: translateX(0); }
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Smooth scroll */
  html {
    scroll-behavior: smooth;
  }

  /* Scroll reveal animations — refined easing */
  [data-reveal] {
    opacity: 0;
    transform: translateY(2rem);
    transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1), transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-reveal="left"] {
    transform: translateX(-2rem);
  }

  [data-reveal="right"] {
    transform: translateX(2rem);
  }

  [data-reveal="scale"] {
    transform: scale(0.95);
  }

  [data-reveal].revealed {
    opacity: 1;
    transform: translateY(0) translateX(0) scale(1);
  }

  /* Staggered children */
  [data-reveal-stagger] > * {
    opacity: 0;
    transform: translateY(1.5rem);
    transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1), transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-reveal-stagger].revealed > *:nth-child(1) { transition-delay: 0.05s; }
  [data-reveal-stagger].revealed > *:nth-child(2) { transition-delay: 0.12s; }
  [data-reveal-stagger].revealed > *:nth-child(3) { transition-delay: 0.19s; }
  [data-reveal-stagger].revealed > *:nth-child(4) { transition-delay: 0.26s; }
  [data-reveal-stagger].revealed > *:nth-child(5) { transition-delay: 0.33s; }
  [data-reveal-stagger].revealed > *:nth-child(6) { transition-delay: 0.40s; }
  [data-reveal-stagger].revealed > *:nth-child(7) { transition-delay: 0.47s; }
  [data-reveal-stagger].revealed > *:nth-child(8) { transition-delay: 0.54s; }

  [data-reveal-stagger].revealed > * {
    opacity: 1;
    transform: translateY(0);
  }

  /* Page transitions */
  @keyframes fadeSlideIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeSlideOut {
    from { opacity: 1; transform: translateY(0); }
    to { opacity: 0; transform: translateY(-8px); }
  }

  ::view-transition-old(root) {
    animation: fadeSlideOut 0.2s ease-in forwards;
  }

  ::view-transition-new(root) {
    animation: fadeSlideIn 0.3s ease-out forwards;
  }

  /* ═══════════════════════════════════════════════════
     Design elevation — Round 11 animations
     ═══════════════════════════════════════════════════ */

  /* Word-by-word headline reveal */
  .word {
    display: inline-block;
    opacity: 0;
    transform: translateY(1.5rem);
    animation: wordReveal 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes wordReveal {
    to { opacity: 1; transform: translateY(0); }
  }

  /* Refined fade up for hero sub-elements */
  .hero-text, .hero-text-2, .hero-cta {
    opacity: 0;
    transform: translateY(1rem);
  }

  @keyframes fadeUp {
    to { opacity: 1; transform: translateY(0); }
  }

  /* Portrait dramatic entrance */
  .portrait-entrance {
    opacity: 0;
    transform: scale(0.9) translateY(2rem);
    animation: portraitEntrance 1.2s cubic-bezier(0.22, 1, 0.36, 1) 0.3s forwards;
  }

  @keyframes portraitEntrance {
    to { opacity: 1; transform: scale(1) translateY(0); }
  }

  /* Gold line extends on load */
  .gold-line {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, #c9a118, transparent);
    z-index: 5;
    width: 0;
    animation: goldLineExtend 1.5s cubic-bezier(0.22, 1, 0.36, 1) 0.6s forwards;
  }

  @keyframes goldLineExtend {
    to { width: 100%; }
  }

  /* CTA button shine sweep */
  .cta-shine {
    position: relative;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .cta-shine::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.3) 40%, rgba(255,255,255,0.5) 50%, rgba(255,255,255,0.3) 60%, transparent 100%);
    z-index: 1;
    transition: none;
  }

  .cta-shine:hover {
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 10px 25px -5px rgba(201, 161, 24, 0.4), 0 0 20px rgba(201, 161, 24, 0.2);
  }

  .cta-shine:hover::before {
    animation: shineSweep 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }

  @keyframes shineSweep {
    to { left: 100%; }
  }

  /* Polished card hover */
  .polished-card {
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.07), 0 2px 4px -2px rgba(0,0,0,0.05);
    transition: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    border: 2px solid transparent;
  }

  .polished-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px -12px rgba(0,0,0,0.1), 0 0 0 1px rgba(201,161,24,0.15), 0 0 20px rgba(201,161,24,0.08);
    border-color: rgba(201, 161, 24, 0.3);
  }

  .card-arrow {
    opacity: 0;
    transform: translateY(4px);
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .polished-card:hover .card-arrow {
    opacity: 1;
    transform: translateY(0);
  }

  .arrow-icon {
    display: inline-block;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .polished-card:hover .arrow-icon {
    transform: translateX(4px);
  }

  /* Ambient background breathing */
  .ambient-bg {
    animation: ambientBreathe 20s ease-in-out infinite;
    transform-origin: center center;
  }

  @keyframes ambientBreathe {
    0%, 100% { transform: scale(1); filter: brightness(1) saturate(1); }
    25% { transform: scale(1.02); filter: brightness(1.04) saturate(1.05); }
    50% { transform: scale(1.01); filter: brightness(0.98) saturate(1.08); }
    75% { transform: scale(1.025); filter: brightness(1.03) saturate(1.02); }
  }

  /* Floating ambient blobs */
  .ambient-blob {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(60px);
  }

  @keyframes blobDrift1 {
    0%, 100% { transform: translate(0, 0); }
    33% { transform: translate(40px, 30px); }
    66% { transform: translate(-20px, 50px); }
  }

  @keyframes blobDrift2 {
    0%, 100% { transform: translate(0, 0); }
    33% { transform: translate(-30px, 40px); }
    66% { transform: translate(25px, -20px); }
  }

  @keyframes blobDrift3 {
    0%, 100% { transform: translate(0, 0); }
    33% { transform: translate(30px, -25px); }
    66% { transform: translate(-35px, 15px); }
  }

  /* Portrait warm glow */
  .portrait-glow {
    position: absolute;
    bottom: 10%;
    left: 50%;
    transform: translateX(-50%);
    width: 80%;
    height: 70%;
    background: radial-gradient(ellipse, rgba(201,161,24,0.15) 0%, rgba(242,48,106,0.08) 40%, transparent 70%);
    filter: blur(40px);
    z-index: 1;
    animation: glowPulse 8s ease-in-out infinite;
  }

  @keyframes glowPulse {
    0%, 100% { opacity: 0.7; transform: translateX(-50%) scale(1); }
    50% { opacity: 1; transform: translateX(-50%) scale(1.05); }
  }

  /* Animated gold bar for SectionHeading */
  .gold-bar-animated {
    width: 0;
    transition: width 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .revealed .gold-bar-animated,
  [data-reveal].revealed + .gold-bar-animated {
    width: 5rem;
  }

  /* Responsive blob sizes */
  @media (max-width: 640px) {
    .ambient-blob { transform: scale(0.5); }
    .portrait-glow { width: 100%; height: 60%; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }

    [data-reveal],
    [data-reveal-stagger] > *,
    .word, .hero-text, .hero-text-2, .hero-cta,
    .portrait-entrance, .card-arrow {
      opacity: 1 !important;
      transform: none !important;
    }

    .gold-line { width: 100% !important; }
    .gold-bar-animated { width: 5rem !important; }
  }

  /* Dark mode — warm artist studio feel */
  html.dark {
    color-scheme: dark;
  }

  html.dark body {
    background-color: #1a1815;
    color: #e8e0d8;
  }

  /* Nav — dark mode handled by inline dark: classes in Nav.astro */

  /* Cards and form containers */
  html.dark .bg-white {
    background-color: #242120;
  }

  html.dark .bg-brand-warm {
    background-color: #1e1c19;
  }

  /* Text adjustments — all opacity variants */
  html.dark .text-brand-dark {
    color: #e8e0d8;
  }

  html.dark .text-brand-dark\/80 {
    color: rgba(232, 224, 216, 0.8);
  }

  html.dark .text-brand-dark\/75 {
    color: rgba(232, 224, 216, 0.75);
  }

  html.dark .text-brand-dark\/70 {
    color: rgba(232, 224, 216, 0.7);
  }

  html.dark .text-brand-dark\/60 {
    color: rgba(232, 224, 216, 0.6);
  }

  html.dark .text-brand-dark\/50 {
    color: rgba(232, 224, 216, 0.5);
  }

  html.dark .text-brand-dark\/40 {
    color: rgba(232, 224, 216, 0.4);
  }

  html.dark .text-brand-dark\/35 {
    color: rgba(232, 224, 216, 0.35);
  }

  /* Placeholder text in dark mode */
  html.dark .placeholder\:text-brand-dark\/35::placeholder,
  html.dark .placeholder\:text-brand-dark\/30::placeholder {
    color: rgba(232, 224, 216, 0.3);
  }

  /* Borders */
  html.dark .border-brand-dark\/5,
  html.dark .border-brand-dark\/20,
  html.dark .border-brand-gold\/20,
  html.dark .border-brand-gold\/30 {
    border-color: rgba(201, 161, 24, 0.15);
  }

  /* Form inputs */
  html.dark input,
  html.dark textarea {
    background-color: #2a2724;
    border-color: rgba(201, 161, 24, 0.2);
    color: #e8e0d8;
  }

  html.dark input::placeholder,
  html.dark textarea::placeholder {
    color: rgba(232, 224, 216, 0.3);
  }

  /* Shadows */
  html.dark .shadow-md,
  html.dark .shadow-lg,
  html.dark .shadow-xl,
  html.dark .shadow-2xl {
    --tw-shadow-color: rgba(0, 0, 0, 0.3);
  }

  /* Footer — dark mode handled by inline dark: classes in Footer.astro */

  /* Mobile menu — dark mode handled by inline dark: classes in Nav.astro */

  /* Hero text shadows for readability in dark mode over images */
  html.dark section[data-dark-overlay] h1,
  html.dark section[data-dark-overlay] p {
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  }

  /* Homepage hero only — darken the light art-background.jpg in dark mode */
  html.dark section[data-dark-overlay]::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(26, 24, 21, 0.65);
    z-index: 1;
    pointer-events: none;
  }

  /* bg-brand-dark sections need contrast in dark mode — slightly lighter than body */
  html.dark .bg-brand-dark {
    background-color: #252220;
  }

  /* Give bg-brand-dark sections a subtle top border for visual separation */
  html.dark section.bg-brand-dark {
    border-top: 1px solid rgba(201, 161, 24, 0.12);
  }

  /* BIR logo already has light backing via inline classes;
     ensure it stays visible in dark mode too */
  html.dark img[src*="build-it-remarkable-logo"] {
    background: rgba(253, 247, 242, 0.9) !important;
  }

  /* Testimonial card — dark mode handled by inline dark: classes in TestimonialCard.astro */

  /* Gradient fades — swap light colors to dark in dark mode */
  html.dark .from-white {
    --tw-gradient-from: #1a1815;
  }

  html.dark .from-brand-warm\/30 {
    --tw-gradient-from: rgba(26, 24, 21, 0.3);
  }

  html.dark .bg-gradient-to-t.from-white,
  html.dark .bg-gradient-to-t.from-brand-warm {
    --tw-gradient-from: #1a1815;
  }

  /* Painterly gradient overlays — hide in dark mode (they use light rgba) */
  html.dark section > [style*="radial-gradient"] {
    opacity: 0 !important;
  }

  /* Homepage hero overlay — dark mode handled by inline dark: classes in index.astro */

  /* StickyCTA — dark mode handled by inline dark: classes in StickyCTA.astro */

  /* BackToTop — already bg-brand-gold, works in both modes */
</style>
