---
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Kellee Wynne Studios — Artist, Author, Mentor' } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | Kellee Wynne Studios`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kellee Wynne Studios" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Kellee Wynne Studios`} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Montserrat:wght@400;500;600;700&family=Cactus+Classical+Serif&display=swap"
      rel="stylesheet"
    />
    <title>{title} | Kellee Wynne Studios</title>
    <ViewTransitions />
    <!-- Dark mode init — runs before paint to prevent flash -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <!-- Global Organization structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Kellee Wynne Studios",
      "url": "https://www.kelleewynne.com",
      "logo": "https://www.kelleewynne.com/images/kellee-wynne-logo.png",
      "sameAs": [
        "https://www.instagram.com/kelleewynne",
        "https://www.youtube.com/c/kelleewynne",
        "https://www.pinterest.com/kelleewynne/"
      ],
      "description": "Kellee Wynne helps artists and makers turn their creative talent into profitable course businesses."
    })} />
    <!-- Page-specific head content (structured data, etc.) -->
    <slot name="head" />
  </head>
  <body class="font-body text-brand-dark bg-white antialiased scroll-pt-20 text-[17px]">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:z-[100] focus:top-4 focus:left-4 focus:bg-white focus:text-brand-dark focus:px-4 focus:py-2 focus:rounded-lg focus:shadow-lg">
      Skip to main content
    </a>
    <!-- Pages can add transition:name="page-title" to h1 elements for smooth cross-page transitions -->
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>

<script>
  // Dark mode toggle — re-registers after View Transitions
  document.addEventListener('astro:page-load', () => {
    (window as any).toggleDarkMode = () => {
      const html = document.documentElement;
      html.classList.toggle('dark');
      localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
    };
  });
</script>

<script>
  // Scroll reveal observer — runs on initial load and after View Transition navigations
  function initScrollReveal() {
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -60px 0px' });

    document.querySelectorAll('[data-reveal], [data-reveal-stagger]').forEach(el => {
      revealObserver.observe(el);
    });
  }

  // Use astro:page-load so it re-runs after View Transitions
  document.addEventListener('astro:page-load', initScrollReveal);
</script>

<style is:global>
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(1.25rem); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeInLeft {
    from { opacity: 0; transform: translateX(-1.5rem); }
    to { opacity: 1; transform: translateX(0); }
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Smooth scroll */
  html {
    scroll-behavior: smooth;
  }

  /* Scroll reveal animations */
  [data-reveal] {
    opacity: 0;
    transform: translateY(2rem);
    transition: opacity 0.7s ease-out, transform 0.7s ease-out;
  }

  [data-reveal="left"] {
    transform: translateX(-2rem);
  }

  [data-reveal="right"] {
    transform: translateX(2rem);
  }

  [data-reveal="scale"] {
    transform: scale(0.95);
  }

  [data-reveal].revealed {
    opacity: 1;
    transform: translateY(0) translateX(0) scale(1);
  }

  /* Staggered children */
  [data-reveal-stagger] > * {
    opacity: 0;
    transform: translateY(1.5rem);
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }

  [data-reveal-stagger].revealed > *:nth-child(1) { transition-delay: 0.05s; }
  [data-reveal-stagger].revealed > *:nth-child(2) { transition-delay: 0.12s; }
  [data-reveal-stagger].revealed > *:nth-child(3) { transition-delay: 0.19s; }
  [data-reveal-stagger].revealed > *:nth-child(4) { transition-delay: 0.26s; }
  [data-reveal-stagger].revealed > *:nth-child(5) { transition-delay: 0.33s; }
  [data-reveal-stagger].revealed > *:nth-child(6) { transition-delay: 0.40s; }
  [data-reveal-stagger].revealed > *:nth-child(7) { transition-delay: 0.47s; }
  [data-reveal-stagger].revealed > *:nth-child(8) { transition-delay: 0.54s; }

  [data-reveal-stagger].revealed > * {
    opacity: 1;
    transform: translateY(0);
  }

  /* Page transitions */
  @keyframes fadeSlideIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeSlideOut {
    from { opacity: 1; transform: translateY(0); }
    to { opacity: 0; transform: translateY(-8px); }
  }

  ::view-transition-old(root) {
    animation: fadeSlideOut 0.2s ease-in forwards;
  }

  ::view-transition-new(root) {
    animation: fadeSlideIn 0.3s ease-out forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }

    [data-reveal],
    [data-reveal-stagger] > * {
      opacity: 1 !important;
      transform: none !important;
    }
  }

  /* Dark mode — warm artist studio feel */
  html.dark {
    color-scheme: dark;
  }

  html.dark body {
    background-color: #1a1815;
    color: #e8e0d8;
  }

  /* Nav in dark mode */
  html.dark #main-nav {
    background-color: rgba(26, 24, 21, 0.95);
    border-bottom: 1px solid rgba(201, 161, 24, 0.15);
  }

  /* Cards and form containers */
  html.dark .bg-white {
    background-color: #242120;
  }

  html.dark .bg-brand-warm {
    background-color: #1e1c19;
  }

  /* Text adjustments */
  html.dark .text-brand-dark {
    color: #e8e0d8;
  }

  html.dark .text-brand-dark\/80 {
    color: rgba(232, 224, 216, 0.8);
  }

  html.dark .text-brand-dark\/70 {
    color: rgba(232, 224, 216, 0.7);
  }

  /* Borders */
  html.dark .border-brand-dark\/5,
  html.dark .border-brand-dark\/20,
  html.dark .border-brand-gold\/20,
  html.dark .border-brand-gold\/30 {
    border-color: rgba(201, 161, 24, 0.15);
  }

  /* Form inputs */
  html.dark input,
  html.dark textarea {
    background-color: #2a2724;
    border-color: rgba(201, 161, 24, 0.2);
    color: #e8e0d8;
  }

  html.dark input::placeholder,
  html.dark textarea::placeholder {
    color: rgba(232, 224, 216, 0.3);
  }

  /* Shadows */
  html.dark .shadow-md,
  html.dark .shadow-lg,
  html.dark .shadow-xl,
  html.dark .shadow-2xl {
    --tw-shadow-color: rgba(0, 0, 0, 0.3);
  }

  /* Footer stays dark in both modes */
  html.dark footer {
    background-color: #111010;
  }

  /* Mobile menu in dark mode */
  html.dark #mobile-menu {
    background-color: rgba(26, 24, 21, 0.95);
  }

  /* Hero sections with light background images — add dark overlay in dark mode */
  html.dark section[class*="-mt-20"]::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(26, 24, 21, 0.65);
    z-index: 1;
    pointer-events: none;
  }

  /* bg-brand-dark sections need contrast in dark mode — slightly lighter than body */
  html.dark .bg-brand-dark {
    background-color: #252220;
  }

  /* Give bg-brand-dark sections a subtle top border for visual separation */
  html.dark section.bg-brand-dark {
    border-top: 1px solid rgba(201, 161, 24, 0.12);
  }

  /* BIR logo and other images with dark text on transparency — add light backing */
  html.dark img[src*="build-it-remarkable-logo"] {
    background: rgba(253, 247, 242, 0.9);
    border-radius: 0.75rem;
    padding: 0.5rem 1rem;
  }

  /* Testimonial card accent corner — tone down in dark mode */
  html.dark .testimonial-card .absolute {
    opacity: 0.3;
  }

  /* StickyCTA bar dark mode */
  html.dark #sticky-cta .bg-white\/90 {
    background-color: rgba(36, 33, 32, 0.92);
  }

  /* BackToTop dark mode */
  html.dark #back-to-top {
    background-color: #c9a118;
  }
</style>
