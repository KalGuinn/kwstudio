---
import { Icon } from 'astro-icon/components';

const socialLinks = [
  { href: 'https://www.instagram.com/kelleewynne', label: 'Instagram', icon: 'simple-icons:instagram' },
  { href: 'https://www.youtube.com/c/kelleewynne', label: 'YouTube', icon: 'simple-icons:youtube' },
  { href: 'https://www.pinterest.com/kelleewynne/', label: 'Pinterest', icon: 'simple-icons:pinterest' },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const legalLinks = [
  { href: `${base}/terms`, label: 'Terms' },
  { href: `${base}/privacy-policy`, label: 'Privacy' },
  { href: `${base}/faq`, label: 'FAQ' },
  { href: `${base}/contact`, label: 'Contact' },
];
---

<!-- Warm top accent border -->
<div class="h-1 bg-gradient-to-r from-brand-pink via-brand-gold to-brand-orange"></div>

<footer class="bg-brand-warm dark:bg-[#111010] text-brand-dark/70 dark:text-white/70 py-16 relative overflow-hidden">
  <div class="relative z-10 max-w-6xl mx-auto px-6 lg:px-10 text-center">

    <!-- Tagline -->
    <p class="font-display text-xl uppercase tracking-widest text-brand-dark/40 dark:text-white/50 mb-8">
      Where creativity meets business
    </p>

    <!-- Decorative gold separator -->
    <div class="flex items-center justify-center gap-3 mb-8">
      <div class="h-px w-16 bg-brand-gold/30"></div>
      <div class="w-1.5 h-1.5 rounded-full bg-brand-gold/50"></div>
      <div class="h-px w-16 bg-brand-gold/30"></div>
    </div>

    <!-- Social -->
    <nav role="navigation" aria-label="Social media links">
      <div class="flex items-center justify-center gap-7 mb-8">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-brand-dark/30 dark:text-white/40 hover:text-brand-gold transition-all duration-200 hover:scale-110 inline-block"
            aria-label={link.label}
          >
            <Icon name={link.icon} class="w-7 h-7" />
          </a>
        ))}
      </div>
    </nav>

    <!-- Decorative gold separator -->
    <div class="flex items-center justify-center gap-3 mb-8">
      <div class="h-px w-16 bg-brand-gold/30"></div>
      <div class="w-1.5 h-1.5 rounded-full bg-brand-gold/50"></div>
      <div class="h-px w-16 bg-brand-gold/30"></div>
    </div>

    <!-- Legal -->
    <div class="flex items-center justify-center gap-6 mb-8 text-sm">
      {legalLinks.map((link) => (
        <a href={link.href} class="hover:text-brand-dark dark:hover:text-white transition-colors duration-200">
          {link.label}
        </a>
      ))}
    </div>

    <!-- Copyright -->
    <p class="text-xs text-brand-dark/40 dark:text-white/50">
      &copy; {new Date().getFullYear()} Kellee Wynne Studios. All rights reserved.
    </p>
  </div>
</footer>
