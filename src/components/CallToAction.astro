---
interface Props {
  headline: string;
  subtitle?: string;
  buttonText: string;
  buttonHref: string;
  variant?: 'dark' | 'warm';
}

const { headline, subtitle, buttonText, buttonHref, variant = 'dark' } = Astro.props;

const bgClass = variant === 'warm' ? 'bg-brand-warm' : 'bg-brand-dark';
const textColor = variant === 'warm' ? 'text-brand-dark' : 'text-white';
const subtitleColor = variant === 'warm' ? 'text-brand-dark/50' : 'text-white/60';
---

<section class={`${bgClass} ${textColor} py-20 sm:py-28`}>
  <div class="max-w-3xl mx-auto px-6 lg:px-10 text-center">
    <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl uppercase mb-4 leading-tight">
      {headline}
    </h2>
    {subtitle && (
      <p class={`text-base sm:text-lg ${subtitleColor} mb-10 max-w-xl mx-auto`}>{subtitle}</p>
    )}
    <a
      href={buttonHref}
      class="inline-block bg-brand-gold text-brand-dark font-display uppercase tracking-widest px-10 py-4 rounded-lg shadow-lg hover:brightness-110 hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300"
    >
      {buttonText}
    </a>
  </div>
</section>
