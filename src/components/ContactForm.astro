---
// Formspree endpoint — replace YOUR_FORM_ID with actual ID when deploying
const formAction = 'https://formspree.io/f/YOUR_FORM_ID';
---

<form action={formAction} method="POST" class="font-body max-w-lg mx-auto space-y-5">
  <div>
    <label for="name" class="sr-only">First and Last Name</label>
    <input
      type="text"
      id="name"
      name="name"
      placeholder="First and Last Name"
      required
      class="w-full px-5 py-4 rounded-xl border border-brand-gold/30 bg-brand-warm text-brand-dark placeholder:text-brand-dark/35 focus:outline-none focus:ring-2 focus:ring-brand-gold/50 focus:border-brand-gold transition"
    />
  </div>
  <div>
    <label for="email" class="sr-only">Email Address</label>
    <input
      type="email"
      id="email"
      name="email"
      placeholder="Email Address"
      required
      class="w-full px-5 py-4 rounded-xl border border-brand-gold/30 bg-brand-warm text-brand-dark placeholder:text-brand-dark/35 focus:outline-none focus:ring-2 focus:ring-brand-gold/50 focus:border-brand-gold transition"
    />
  </div>
  <div>
    <label for="message" class="sr-only">Your Message</label>
    <textarea
      id="message"
      name="message"
      placeholder="Your message — we read every single one."
      rows="5"
      required
      class="w-full px-5 py-4 rounded-xl border border-brand-gold/30 bg-brand-warm text-brand-dark placeholder:text-brand-dark/35 focus:outline-none focus:ring-2 focus:ring-brand-gold/50 focus:border-brand-gold transition resize-none"
    ></textarea>
  </div>
  <button
    type="submit"
    class="cta-shine w-full bg-brand-gold text-brand-dark font-display uppercase tracking-widest px-10 py-4 rounded-lg shadow-lg hover:brightness-110 hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300"
  >
    <span class="relative z-10">Send Message</span>
  </button>
</form>
