---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import artBackground from '../assets/images/art-background.jpg';

interface Props {
  variant?: 'warm' | 'dark' | 'art';
  title: string;
  overline?: string;
  subtitle?: string;
  image?: { src: ImageMetadata; alt: string };
  cta?: { text: string; href: string };
  className?: string;
}

const { variant = 'warm', title, overline, subtitle, image, cta, className } = Astro.props;

const bgClasses: Record<string, string> = {
  warm: 'bg-brand-warm text-brand-dark',
  dark: 'bg-brand-dark text-white',
  art: 'bg-brand-dark text-white',
};

const titleColor: Record<string, string> = {
  warm: 'text-brand-dark',
  dark: 'text-white',
  art: 'text-white',
};

const subtitleColor: Record<string, string> = {
  warm: 'text-brand-dark/70',
  dark: 'text-white/70',
  art: 'text-white/70',
};

const overlineColor: Record<string, string> = {
  warm: 'text-brand-pink',
  dark: 'text-brand-gold',
  art: 'text-brand-gold',
};
---

<section
  class:list={[
    'relative overflow-hidden -mt-20 pt-24 sm:pt-28 pb-12',
    bgClasses[variant],
    className,
  ]}
>
  {variant === 'art' && (
    <div class="absolute inset-0">
      <Image
        src={artBackground}
        alt=""
        class="w-full h-full object-cover opacity-30"
        loading="eager"
        aria-hidden="true"
      />
      <div class="absolute inset-0 bg-brand-dark/60"></div>
    </div>
  )}

  <div class="relative z-10 max-w-4xl mx-auto px-6 lg:px-10 text-center">
    {overline && (
      <p class:list={[
        'text-xs sm:text-sm font-semibold tracking-[0.2em] uppercase mb-4',
        overlineColor[variant],
      ]}>
        {overline}
      </p>
    )}

    <h1 class:list={[
      'font-display text-3xl sm:text-4xl lg:text-5xl uppercase leading-tight mb-6',
      titleColor[variant],
    ]}>
      <Fragment set:html={title} />
    </h1>

    {image && (
      <div class="mb-8">
        <Image
          src={image.src}
          alt={image.alt}
          class="mx-auto max-w-full rounded-lg shadow-lg"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )}

    {subtitle && (
      <p class:list={[
        'text-base sm:text-lg max-w-xl mx-auto leading-relaxed mb-8',
        subtitleColor[variant],
      ]}>
        {subtitle}
      </p>
    )}

    {cta && (
      <a
        href={cta.href}
        class="inline-block bg-brand-gold text-brand-dark font-display uppercase tracking-widest px-10 py-4 rounded-lg shadow-lg hover:brightness-110 hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300"
      >
        {cta.text}
      </a>
    )}

    <slot />
  </div>
</section>
