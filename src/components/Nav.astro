---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { navLinks, socialLinks } from '../data/navigation';
import logo from '../assets/images/kellee-wynne-logo.png';

interface Props {
  currentPage?: string;
}

const { currentPage = '' } = Astro.props;
---

<nav aria-label="Main navigation" class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md shadow-sm dark:bg-[#1a1815]/95 dark:border-b dark:border-brand-gold/15" id="main-nav">
  <div class="max-w-7xl mx-auto px-4 lg:px-6">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href={navLinks[0].href} class="flex-shrink-0">
        <Image
          src={logo}
          alt="Kellee Wynne Studios"
          class="h-10 w-auto md:h-12 transition-all duration-300"
        />
      </a>

      <!-- Nav Links (desktop) -->
      <div class="hidden md:flex items-center gap-5 lg:gap-7">
        {navLinks.map((link) => (
          link.cta ? (
            <a
              href={link.href}
              aria-current={currentPage === link.href ? 'page' : undefined}
              class:list={[
                'text-sm font-semibold tracking-wider uppercase px-4 py-1.5 rounded-full border-2 transition-all duration-200',
                currentPage === link.href
                  ? 'bg-brand-gold border-brand-gold text-white'
                  : 'border-brand-gold text-brand-gold hover:bg-brand-gold hover:text-white',
              ]}
            >
              {link.label}
            </a>
          ) : (
            <a
              href={link.href}
              aria-current={currentPage === link.href ? 'page' : undefined}
              class:list={[
                'relative text-sm font-semibold tracking-wider uppercase transition-colors duration-200',
                'after:absolute after:bottom-[-4px] after:left-0 after:h-0.5 after:bg-brand-pink after:transition-all after:duration-300',
                currentPage === link.href
                  ? 'text-brand-pink after:w-full'
                  : 'text-brand-dark/70 hover:text-brand-pink after:w-0 hover:after:w-full',
              ]}
            >
              {link.label}
            </a>
          )
        ))}
      </div>

      <!-- Social Links + Dark Mode Toggle (desktop) -->
      <div class="hidden md:flex items-center gap-3">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-brand-dark/50 hover:text-brand-pink transition-colors duration-200 dark:text-white/50 dark:hover:text-brand-gold"
            aria-label={link.label}
          >
            <Icon name={link.icon} class="w-5 h-5" />
          </a>
        ))}

        <!-- Dark mode toggle -->
        <button
          id="dark-mode-toggle"
          class="p-2 text-brand-dark/50 hover:text-brand-pink transition-colors duration-200 dark:text-white/50 dark:hover:text-brand-gold"
          aria-label="Toggle dark mode"
          onclick="toggleDarkMode()"
        >
          <!-- Sun icon (shown in dark mode) -->
          <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
          </svg>
          <!-- Moon icon (shown in light mode) -->
          <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
          </svg>
        </button>
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 text-brand-dark/60 hover:text-brand-pink dark:text-white/60 dark:hover:text-brand-gold"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden pb-6 bg-white/95 backdrop-blur-sm rounded-b-2xl shadow-lg -mx-4 px-4 dark:bg-[#1a1815]/95">
      <div class="flex flex-col gap-1 pt-2">
        {navLinks.map((link) => (
          link.cta ? (
            <a
              href={link.href}
              aria-current={currentPage === link.href ? 'page' : undefined}
              class:list={[
                'mx-4 my-1 px-4 py-3 text-sm font-semibold tracking-wider uppercase rounded-full border-2 text-center transition-all duration-200',
                currentPage === link.href
                  ? 'bg-brand-gold border-brand-gold text-white'
                  : 'border-brand-gold text-brand-gold hover:bg-brand-gold hover:text-white',
              ]}
            >
              {link.label}
            </a>
          ) : (
            <a
              href={link.href}
              aria-current={currentPage === link.href ? 'page' : undefined}
              class:list={[
                'px-4 py-3 text-sm font-semibold tracking-wider uppercase rounded-lg transition-colors',
                currentPage === link.href
                  ? 'text-brand-pink bg-brand-pink/5'
                  : 'text-brand-dark/60 hover:text-brand-pink hover:bg-brand-pink/5',
              ]}
            >
              {link.label}
            </a>
          )
        ))}
      </div>
      <div class="flex items-center gap-5 mt-4 px-4 pt-4 border-t border-gray-100 dark:border-brand-gold/15">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-brand-dark/40 hover:text-brand-pink transition-colors dark:text-white/40 dark:hover:text-brand-gold"
            aria-label={link.label}
          >
            <Icon name={link.icon} class="w-5 h-5" />
          </a>
        ))}

        <!-- Dark mode toggle (mobile) -->
        <button
          class="ml-auto p-2 text-brand-dark/40 hover:text-brand-pink transition-colors duration-200 dark:text-white/40 dark:hover:text-brand-gold"
          aria-label="Toggle dark mode"
          onclick="toggleDarkMode()"
        >
          <!-- Sun icon (shown in dark mode) -->
          <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
          </svg>
          <!-- Moon icon (shown in light mode) -->
          <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</nav>

<!-- Spacer for fixed nav -->
<div class="h-20"></div>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const isHidden = menu?.classList.toggle('hidden');
    btn?.setAttribute('aria-expanded', String(!isHidden));
  });

</script>
