---
interface Props {
  quote: string;
  name: string;
  title: string;
  initial: string;
}

const { quote, name, title, initial } = Astro.props;
---

<div class="testimonial-card group relative bg-brand-warm border border-brand-gold/20 rounded-2xl p-8 shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300">
  <div class="text-brand-gold/40 font-display text-5xl leading-none select-none mb-4" aria-hidden="true">&ldquo;</div>
  <blockquote class="text-brand-dark/75 text-base leading-relaxed mb-6">
    <Fragment set:html={quote} />
  </blockquote>
  <div class="flex items-center gap-3">
    <div class="w-10 h-10 rounded-full bg-brand-pink/15 flex items-center justify-center flex-shrink-0">
      <span class="font-display text-brand-pink text-base">{initial}</span>
    </div>
    <div>
      <p class="font-semibold text-sm text-brand-dark">{name}</p>
      <p class="text-xs text-brand-dark/40 tracking-wide">{title}</p>
    </div>
  </div>
  <!-- Accent corner -->
  <div class="absolute top-0 right-0 w-12 h-12 rounded-tr-2xl overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-bl from-brand-gold/20 to-transparent"></div>
  </div>
</div>
