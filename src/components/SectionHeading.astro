---
interface Props {
  overline?: string;
  title: string;
  centered?: boolean;
}

const { overline, title, centered = true } = Astro.props;
---

<div class:list={[centered && 'text-center']}>
  {overline && (
    <p class:list={[
      'text-xs sm:text-sm font-semibold tracking-[0.2em] uppercase text-brand-pink mb-3',
      centered && 'text-center',
    ]}>
      {overline}
    </p>
  )}
  <h2 class:list={[
    'font-display text-2xl sm:text-3xl lg:text-4xl uppercase text-brand-dark leading-tight mb-4',
    centered && 'text-center',
  ]}>
    <Fragment set:html={title} />
  </h2>
  <div class:list={[
    'w-20 h-1 bg-brand-gold rounded-full mb-8',
    centered && 'mx-auto',
  ]}></div>
</div>
