---
interface Props {
  buttonText: string;
  buttonHref: string;
  label?: string;
}

const { buttonText, buttonHref, label } = Astro.props;
---

<div
  id="sticky-cta"
  class="fixed bottom-0 left-0 right-0 z-40 translate-y-full transition-transform duration-300 ease-out"
>
  <div class="bg-white/90 backdrop-blur-md border-t border-brand-gold/20 shadow-[0_-4px_20px_rgba(0,0,0,0.08)] px-6 py-3 dark:bg-[#242120]/92 dark:border-brand-gold/15">
    <div class="max-w-4xl mx-auto flex items-center justify-between gap-4">
      {label && (
        <p class="hidden sm:block font-accent text-brand-dark/80 text-sm italic flex-1 dark:text-white/80">{label}</p>
      )}
      <a
        href={buttonHref}
        class="bg-brand-gold text-brand-dark font-display uppercase tracking-widest text-sm px-8 py-3 rounded-lg shadow-md hover:brightness-110 hover:shadow-lg transition-all duration-200 whitespace-nowrap mx-auto sm:mx-0"
      >
        {buttonText}
      </a>
    </div>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const bar = document.getElementById('sticky-cta');
    if (!bar) return;

    let visible = false;
    const show = () => { if (!visible) { bar.classList.remove('translate-y-full'); visible = true; } };
    const hide = () => { if (visible) { bar.classList.add('translate-y-full'); visible = false; } };

    window.addEventListener('scroll', () => {
      const scrollY = window.scrollY;
      const docHeight = document.documentElement.scrollHeight;
      const winHeight = window.innerHeight;
      const distFromBottom = docHeight - scrollY - winHeight;

      if (scrollY > 400 && distFromBottom > 500) {
        show();
      } else {
        hide();
      }
    }, { passive: true });
  });
</script>
